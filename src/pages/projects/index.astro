---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { company } from '../../data/company';
import { localeUrl, useTranslations, type Locale } from '../../i18n/utils';
import { publicFileExists } from '../../lib/assets';
import { cleanText } from '../../lib/todos';

// Листинг: 3 избрани проекта като големи карти + таблица „Архив“ с всички (DESIGN.md
// §Листинг на проектите). Данните са само от колекцията projects.
const locale: Locale = 'bg';
const t = useTranslations(locale);

const all = await getCollection('projects', (p) => p.id.startsWith('bg/'));
const slugOf = (id: string) => id.replace(/^bg\/projects\//, '');
const hrefOf = (id: string) => localeUrl(locale, `/projects/${slugOf(id)}`);

const featured = all.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const rows = [...all].sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);

// title/description от content/bg/projects.md (тялото му не се рендерира — листингът е от
// колекцията); ако файлът липсва — етикетът от навигацията и без description.
const page = await getEntry('pages', 'bg/projects');
const title = page?.data.title ?? `${t('nav.projects')} – ${company.brand}`;
---

<Base title={title} description={page?.data.description} locale={locale}>
  <section class="wrap listing">
    <h1>{t('nav.projects')}</h1>

    <div class="featured">
      {
        featured.map((p, i) => {
          const img = p.data.images[0];
          const href = hrefOf(p.id);
          return (
            <article class="card">
              <a class="media figure" href={href} tabindex="-1" aria-hidden="true">
                {img && publicFileExists(img.src) ? (
                  <img
                    class="shot"
                    src={img.src}
                    alt=""
                    width="1200"
                    height="750"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                  />
                ) : (
                  <Placeholder label={t('placeholder.screenshot')} caption={img?.alt} ratio="16 / 10" />
                )}
              </a>
              <div class="card-text">
                <p class="tags">
                  <span class="mono">{p.data.year}</span> · {p.data.client} · {p.data.services.join(' · ')}
                </p>
                <h2>
                  <a href={href} set:html={cleanText(p.data.result)} />
                </h2>
              </div>
            </article>
          );
        })
      }
    </div>

    <h2 class="archive-title">{t('projects.archive')}</h2>
    <!-- role атрибутите пазят табличната семантика на мобилно, където display-ът е block/grid. -->
    <table class="archive" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">{t('facts.year')}</th>
          <th role="columnheader" scope="col">{t('facts.client')}</th>
          <th role="columnheader" scope="col">{t('facts.services')}</th>
          <th role="columnheader" scope="col">{t('facts.stack')}</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          rows.map((p) => (
            <tr role="row">
              <td role="cell" class="mono year">{p.data.year}</td>
              <td role="cell" class="client">
                <a href={hrefOf(p.id)}>{p.data.client}</a>
                {p.data.status === 'in-progress' && <span class="tag">{t('projects.inProgress')}</span>}
              </td>
              <td role="cell" class="services">{p.data.services.join(' · ')}</td>
              <td role="cell" class="mono stack">{p.data.stack.join(' · ')}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Base>

<style>
  .listing {
    padding-block: var(--spacing-12) var(--spacing-24);
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--spacing-12);
  }

  /* Избрани: първата карта е широка (7/12 + 5/12), другите две — половинки. Не са еднакви. */
  .featured {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-12);
  }

  .card {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-4);
  }

  .card .media,
  .card .card-text {
    grid-column: 1 / -1;
  }

  .media {
    display: block;
  }

  /* Година в mono; клиент и услуги в body — българските имена нямат mono с български форми. */
  .tags {
    margin: 0 0 var(--spacing-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .card h2 {
    font-size: var(--text-lg);
    line-height: 1.25;
    margin: 0;
  }

  .card h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .card h2 a:hover {
    text-decoration: underline;
    text-underline-offset: var(--spacing-1);
    text-decoration-thickness: 1px;
  }

  /* Архив: таблична решетка; на мобилно всеки ред е блок в две колони. Подзаглавие на
     листинга, затова е под h2 на голямата карта. */
  .archive-title {
    font-size: var(--text-lg);
    line-height: 1.25;
    margin: var(--spacing-24) 0 var(--spacing-6);
  }

  .archive {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .archive,
  .archive tbody {
    display: block;
  }

  /* Заглавният ред е скрит визуално, не от четците (display:none би махнал семантиката). */
  .archive thead {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .archive tr {
    display: grid;
    grid-template-columns: 5ch 1fr;
    column-gap: var(--spacing-3);
    padding-block: var(--spacing-3);
    border-top: 1px solid var(--color-line);
    position: relative;
  }

  .archive tr:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .archive td {
    display: block;
    line-height: 1.5;
  }

  .archive .services,
  .archive .stack {
    grid-column: 2;
  }

  .archive .stack {
    color: var(--color-muted);
  }

  /* Линкът е видим и без hover (подчертан в цвета на линията); целият ред е зона за
     докосване през разпънат ::after. */
  .archive .client a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: var(--spacing-1);
    text-decoration-thickness: 1px;
  }

  .archive .client a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .archive tbody tr:hover {
    background: var(--color-surface);
  }

  .archive tbody tr:hover .client a {
    text-decoration-color: var(--color-primary);
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .listing {
      padding-block: var(--spacing-16) var(--spacing-32);
    }

    h1 {
      font-size: var(--text-3xl);
    }

    .card:first-child .media {
      grid-column: 1 / span 7;
    }

    .card:first-child .card-text {
      grid-column: 8 / span 5;
      align-self: center;
    }

    .card:first-child h2 {
      font-size: var(--text-xl);
      line-height: 1.15;
    }

    .card:not(:first-child) {
      grid-column: span 6;
      display: block;
    }

    .card:not(:first-child) .media {
      margin-bottom: var(--spacing-4);
    }

    .archive {
      display: table;
    }

    .archive thead {
      display: table-header-group;
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }

    .archive tbody {
      display: table-row-group;
    }

    .archive tr {
      display: table-row;
      padding: 0;
    }

    .archive th,
    .archive td {
      display: table-cell;
      text-align: left;
      vertical-align: top;
      padding: var(--spacing-3) var(--spacing-4) var(--spacing-3) 0;
      border-top: 1px solid var(--color-line);
    }

    .archive th {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-muted);
      border-top: 0;
    }

    .archive tr:last-child td {
      border-bottom: 1px solid var(--color-line);
    }

    .archive tr:last-child {
      border-bottom: 0;
    }

    .archive .year {
      width: 5ch;
    }

    .archive .services {
      width: 25%;
    }

    .archive .stack {
      width: 35%;
    }
  }
</style>
