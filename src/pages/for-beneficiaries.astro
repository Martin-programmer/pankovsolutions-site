---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Partner from '../components/Partner.astro';
import { localeUrl, useTranslations, type Locale } from '../i18n/utils';
import { md, mdInline, slugify, splitH2, takeHeading, takeLastLinkLine } from '../lib/markdown';
import { cleanHtml, cleanText, warnTodos } from '../lib/todos';

// Само от content/bg/for-beneficiaries.md. Редакторски двуколонен layout: вляво съдържание
// на страницата (sticky, само на десктоп), вдясно текстът по секции. Секцията, в която се
// споменава партньорът от clients.yaml, минава през Partner.astro; секция, която е само
// списък с линкове към кейсове, се набира като таблица от данните на проектите
// („ръчна котва“, CHECKLIST §A).
const locale: Locale = 'bg';
const t = useTranslations(locale);

const page = await getEntry('pages', 'bg/for-beneficiaries');
if (!page) throw new Error('content/bg/for-beneficiaries.md липсва');
warnTodos(page.filePath ?? page.id, page.body);

const partner = (await getCollection('clients')).find((c) => c.data.partner);
// „Еко Глоуб ООД“ → „Еко Глоуб“ — в текста името е в кавички, без правната форма.
const partnerKey = partner?.data.name.replace(/\s*(ООД|ЕООД|АД|ЕАД)$/, '') ?? '';

const projects = await getCollection('projects', (p) => p.id.startsWith('bg/'));
const projectBySlug = new Map(projects.map((p) => [p.id.replace(/^bg\/projects\//, ''), p]));

const { preface, sections: raw } = splitH2(page.body ?? '');
const { heading: h1, rest: ledeMd } = takeHeading(preface, 1);
const lede = cleanHtml(await md(ledeMd));

type Row = { slug: string; href: string; year: number; client: string; program: string; services: string };

let cta: { text: string; href: string } | null = null;
const sections = [];
for (const [i, s] of raw.entries()) {
  let body = s.body;
  if (i === raw.length - 1) {
    const { rest, links } = takeLastLinkLine(body);
    body = rest;
    cta = links[0] ?? null;
  }

  // Списък само от линкове към /projects/<slug> → таблица от колекцията.
  const lines = body.split('\n').filter((l) => l.trim());
  const linkItems = lines.map((l) => l.match(/^-\s*\[[^\]]+\]\(\/projects\/([^)#?]+)\)\s*$/));
  const rows: Row[] | null =
    lines.length > 0 && linkItems.every(Boolean)
      ? linkItems.flatMap((m) => {
          const p = projectBySlug.get(m![1]);
          if (!p) return [];
          return [
            {
              slug: m![1],
              href: localeUrl(locale, `/projects/${m![1]}`),
              year: p.data.year,
              client: cleanText(p.data.client),
              program: cleanText(p.data.program),
              services: p.data.services.join(' · '),
            },
          ];
        })
      : null;

  sections.push({
    id: slugify(s.heading),
    heading: await mdInline(s.heading),
    html: cleanHtml(await md(body)),
    isPartner: Boolean(partnerKey) && body.includes(partnerKey),
    rows,
  });
}
---

<Base title={page.data.title} description={page.data.description} locale={locale}>
  <div class="wrap layout">
    <div class="content tile tile-surface">
      <header class="head">
        <h1 set:html={await mdInline(h1)} />
        <div class="prose lede" set:html={lede} />
      </header>

      {
        sections.map((s) => (
          <section id={s.id} aria-labelledby={`${s.id}-title`}>
            <h2 id={`${s.id}-title`} set:html={s.heading} />
            {s.isPartner ? (
              <Partner partner={partner} html={s.html} locale={locale} />
            ) : s.rows ? (
              <table class="programs" role="table">
                <thead role="rowgroup">
                  <tr role="row">
                    <th role="columnheader" scope="col">{t('facts.client')}</th>
                    <th role="columnheader" scope="col">{t('facts.program')}</th>
                    <th role="columnheader" scope="col">{t('facts.services')}</th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {s.rows.map((r) => (
                    <tr role="row">
                      <td role="cell" class="client">
                        <a href={r.href}>{r.client}</a>
                        {projectBySlug.get(r.slug)?.data.status === 'in-progress' && (
                          <span class="tag">{t('projects.inProgress')}</span>
                        )}
                      </td>
                      <td role="cell" class="program">{r.program}</td>
                      <td role="cell" class="services">{r.services}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div class="prose" set:html={s.html} />
            )}
          </section>
        ))
      }

      {
        cta && (
          <p class="cta">
            <a class="btn" href={cta.href}>
              {cta.text}
            </a>
          </p>
        )
      }
    </div>

    <!-- След съдържанието в DOM (Tab и четци стигат първо до h1); визуално вляво през grid. -->
    <nav class="toc tile tile-cool" aria-label={t('toc.label')}>
      <p class="toc-title">{t('toc.label')}</p>
      <ol>
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`} set:html={s.heading} />
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-6);
    padding-block: var(--spacing-8) var(--spacing-16);
  }

  /* Съдържанието на страницата е само за десктоп (DESIGN: „вляво sticky … само на десктоп“). */
  .toc {
    display: none;
  }

  .content {
    grid-column: 1 / -1;
  }

  /* xl на мобилно: „изпълнител,“ не се побира на 294 px при 2xl. */
  h1 {
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--spacing-6);
  }

  .lede :global(p) {
    font-size: var(--text-base);
  }

  .head {
    margin-bottom: var(--spacing-12);
  }

  section {
    padding-block: var(--spacing-8);
    border-top: 1px solid var(--color-line);
    /* Котвата да не се крие под горния ръб. */
    scroll-margin-top: var(--spacing-8);
  }

  section h2 {
    font-size: var(--text-lg);
    line-height: 1.25;
    margin: 0 0 var(--spacing-4);
  }

  .prose :global(p:last-child),
  .prose :global(ul:last-child) {
    margin-bottom: 0;
  }

  /* Таблица на проектите по програми: на мобилно всеки ред е блок в две колони,
     семантиката се пази с role атрибути и визуално скрит заглавен ред. */
  .programs {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .programs,
  .programs tbody {
    display: block;
  }

  .programs thead {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .programs tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--spacing-1);
    padding-block: var(--spacing-3);
    border-top: 1px solid var(--color-line);
    position: relative;
  }

  .programs tr:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .programs td {
    display: block;
    line-height: 1.5;
  }

  .programs .program,
  .programs .services {
    color: var(--color-muted);
  }

  .programs .client a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: var(--spacing-1);
    text-decoration-thickness: 1px;
  }

  .programs .client a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Плочката е бяла — hover в surface би бил невидим; paper е следващият тон от палитрата. */
  .programs tbody tr:hover {
    background: var(--color-paper);
  }

  .programs tbody tr:hover .client a {
    text-decoration-color: var(--color-primary);
  }

  .cta {
    margin: var(--spacing-12) 0 0;
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .layout {
      padding-block: var(--spacing-12) var(--spacing-24);
    }

    /* Под sticky хедъра (~80 px): top = хедър + отстъп. */
    .toc {
      display: block;
      grid-column: 1 / span 3;
      grid-row: 1;
      position: sticky;
      top: calc(var(--spacing-24) + var(--spacing-4));
      align-self: start;
      font-size: var(--text-sm);
      padding: var(--spacing-6);
    }

    .toc-title {
      margin: 0 0 var(--spacing-3);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-muted);
    }

    .toc ol {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--color-line);
    }

    .toc li {
      border-bottom: 1px solid var(--color-line);
    }

    .toc a {
      display: block;
      padding-block: var(--spacing-3);
      color: var(--color-ink);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: var(--spacing-1);
      text-decoration-thickness: 1px;
    }

    .content {
      grid-column: 5 / span 8;
      grid-row: 1;
    }

    /* 48 px, не 64: заглавието е цяло изречение в 8/12 колони — на 64 px става 5 реда и
       е по-високо от целия увод. Същият размер като h1 на кейсовете. */
    h1 {
      font-size: var(--text-2xl);
    }

    section {
      padding-block: var(--spacing-12);
    }

    section h2 {
      font-size: var(--text-xl);
      line-height: 1.15;
      margin-bottom: var(--spacing-6);
    }

    .programs {
      display: table;
    }

    .programs thead {
      display: table-header-group;
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }

    .programs tbody {
      display: table-row-group;
    }

    .programs tr {
      display: table-row;
      padding: 0;
    }

    .programs th,
    .programs td {
      display: table-cell;
      text-align: left;
      vertical-align: top;
      padding: var(--spacing-3) var(--spacing-4) var(--spacing-3) 0;
      border-top: 1px solid var(--color-line);
    }

    .programs th {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-muted);
      border-top: 0;
    }

    .programs tr:last-child td {
      border-bottom: 1px solid var(--color-line);
    }

    .programs tr:last-child {
      border-bottom: 0;
    }

  }
</style>
