---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import { md, mdInline, splitH2, takeHeading } from '../lib/markdown';
import { publicFileExists, publicImageSize } from '../lib/assets';
import { cleanHtml, warnTodos } from '../lib/todos';

// Само от content/bg/products.md. „Една карта, етикет „в разработка“, без линк, описание,
// един кадър от AR менюто“ — DESIGN.md §Продукти. Кадърът е placeholder до качване.
const locale: Locale = 'bg';
const t = useTranslations(locale);

const page = await getEntry('pages', 'bg/products');
if (!page) throw new Error('content/bg/products.md липсва');
warnTodos(page.filePath ?? page.id, page.body);

// Кадърът от frontmatter-а (image); ако файлът липсва — wireframe placeholder.
const image = page.data.image && publicFileExists(page.data.image.src) ? page.data.image : null;
const imageSize = image ? await publicImageSize(image.src) : null;

const { preface, sections } = splitH2(page.body ?? '');
const { heading: h1, rest: ledeMd } = takeHeading(preface, 1);
const lede = cleanHtml(await md(ledeMd));

// „## FudiAR `в разработка`“ → име + етикет (кодът в заглавието е етикетът).
const products = [];
for (const s of sections) {
  const m = s.heading.match(/^(.*?)\s*`([^`]+)`\s*$/);
  products.push({
    name: await mdInline(m ? m[1] : s.heading),
    label: m ? m[2] : '',
    html: cleanHtml(await md(s.body)),
  });
}
---

<Base title={page.data.title} description={page.data.description} locale={locale}>
  <header class="wrap head">
    <h1 set:html={await mdInline(h1)} />
    <div class="prose lede" set:html={lede} />
  </header>

  <section class="wrap">
    {
      products.map((p) => (
        <article class="product tile tile-surface reveal">
          <div class="media">
            {image && imageSize ? (
              <div class="frame">
                <div class="frame-bar">{image.alt}</div>
                <img
                  class="frame-body"
                  src={image.src}
                  alt={image.alt}
                  width={imageSize.width}
                  height={imageSize.height}
                  loading="lazy"
                />
              </div>
            ) : (
              <Placeholder label={t('placeholder.screenshot')} ratio="4 / 5" />
            )}
          </div>
          <div class="text">
            <!-- Етикетът е извън <h2>, за да не влиза в името на продукта за четци и outline. -->
            <div class="title">
              <h2 set:html={p.name} />
              {p.label && <span class="tag">{p.label}</span>}
            </div>
            <div class="prose" set:html={p.html} />
          </div>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .head {
    padding-block: var(--spacing-12) var(--spacing-8);
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--spacing-6);
  }

  .lede :global(p) {
    font-size: var(--text-base);
  }

  section {
    padding-block: var(--spacing-8) var(--spacing-24);
  }

  /* Една плочка (DESIGN.md §Ревизия), без линк. Кадър 4:5 вляво, текст вдясно. */
  .product {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--spacing-6);
  }

  .media,
  .text {
    grid-column: 1 / -1;
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-3);
    margin: 0 0 var(--spacing-4);
  }

  .product h2 {
    font-size: var(--text-xl);
    line-height: 1.15;
    margin: 0;
  }

  .product .tag {
    margin: 0;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .head {
      padding-block: var(--spacing-16) var(--spacing-12);
    }

    h1 {
      font-size: var(--text-3xl);
    }

    section {
      padding-block: var(--spacing-8) var(--spacing-32);
    }

    /* Кадърът е широк (сайт), затова 6/12 + 6/12, не 4/12 като при портретен placeholder. */
    .media {
      grid-column: 1 / span 6;
    }

    .text {
      grid-column: 7 / span 6;
      align-self: center;
    }
  }
</style>
