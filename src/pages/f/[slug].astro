---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EligibilitySurvey from '../../components/EligibilitySurvey.astro';
import Placeholder from '../../components/Placeholder.astro';
import Process from '../../components/Process.astro';
import { company } from '../../data/company';
import { localeUrl, useTranslations, type Locale } from '../../i18n/utils';
import { publicFileExists, publicImageSize } from '../../lib/assets';
import { toJsonLd } from '../../lib/jsonld';
import {
  md,
  mdInline,
  paragraphs,
  parseFaq,
  parseRunIns,
  parseStepLines,
  parseTermLines,
  plainText,
  splitH3,
  splitSections,
  takeHeading,
} from '../../lib/markdown';
import { cleanHtml, cleanText, warnTodos } from '../../lib/todos';

// Лендинг по процедура/ниша (docs/11). Една цел: запитване за безплатна проверка на
// допустимостта. Фиксираната част (X) идва от content/bg/campaigns/_shared.md, променливата
// (Y) - от content/bg/campaigns/<slug>.md. Хедърът е минимален (лого, телефон, CTA), футърът
// е пълният (фирмени данни по ЗЕТ + доверие). Нищо от текста не е написано тук.
//
// Ред на секциите (всяка с различна структура от предишната):
//   hero (текст 7/12 + снимка 5/12) → лента с числата на процедурата → ред доверие с логата →
//   за кого (две колони +/-) → какво се финансира (софтуерът първи) → примери (таблица) →
//   банер → „нищо не плащате до одобрение“ → как става (5 стъпки) → кой стои зад това →
//   доказателство (кадри, таблица, отзив) → защо сега → FAQ → форма.
export async function getStaticPaths() {
  const campaigns = await getCollection('campaigns', (c) => c.id.startsWith('bg/'));
  return campaigns.map((c) => ({ params: { slug: c.id.replace(/^bg\/campaigns\//, '') }, props: { entry: c } }));
}

interface Props {
  entry: CollectionEntry<'campaigns'>;
}

const { entry } = Astro.props as Props;
const locale: Locale = 'bg';
const t = useTranslations(locale);
const isProd = import.meta.env.PROD;
const showPlaceholders = !isProd || process.env.SHOW_PLACEHOLDERS === '1';
const slug = entry.id.replace(/^bg\/campaigns\//, '');
const campaignId = entry.data.campaign ?? slug;
const cta = { text: t('cta.check'), href: '#form' };

const shared = await getEntry('campaignBlocks', 'bg/campaigns/_shared');
if (!shared) throw new Error('content/bg/campaigns/_shared.md липсва');
warnTodos(entry.filePath ?? entry.id, entry.body);
warnTodos(shared.filePath ?? shared.id, shared.body);

const own = splitSections(entry.body ?? '');
const common = splitSections(shared.body ?? '');
const need = (map: Map<string, string>, key: string, file: string) => {
  const v = map.get(key);
  if (v === undefined) throw new Error(`${file}: няма секция <!-- ${key} -->`);
  return v;
};

// „## Заглавие“ + произволен markdown (без CTA ред).
const headed = async (source: string) => {
  const { heading, rest } = takeHeading(source, 2);
  return { heading: await mdInline(heading), body: rest };
};
// „## Заглавие“ + „### Подзаглавие“ + текст - двуколонните секции.
const columns = async (source: string) => {
  const { heading, body } = await headed(source);
  const { sections } = splitH3(body);
  return {
    heading,
    cols: await Promise.all(
      sections.map(async (c) => ({ heading: await mdInline(c.heading), html: cleanHtml(await md(c.body)) })),
    ),
  };
};

// --- Променлива част (Y) ---
const heroSrc = need(own, 'HERO', slug);
const { heading: h1Md, rest: ledeMd } = takeHeading(heroSrc, 1);
const hero = { title: await mdInline(h1Md), lede: cleanHtml(await md(ledeMd)) };
const who = own.has('ЗА КОГО') ? await columns(own.get('ЗА КОГО')!) : null;
const funds = own.has('ФИНАНСИРА') ? await columns(own.get('ФИНАНСИРА')!) : null;
const examples = own.has('ПРИМЕРИ')
  ? await (async () => {
      const { heading, body } = await headed(own.get('ПРИМЕРИ')!);
      return { heading, items: await parseTermLines(body) };
    })()
  : null;
const whyNow = own.has('ЗАЩО СЕГА')
  ? await (async () => {
      const { heading, body } = await headed(own.get('ЗАЩО СЕГА')!);
      return { heading, html: cleanHtml(await md(body)) };
    })()
  : null;
const ownFaq = own.has('FAQ') ? await parseFaq(own.get('FAQ')!) : [];

// --- Фиксирана част (X) ---
const trustLine = cleanHtml(await mdInline(need(common, 'ДОВЕРИЕ', '_shared')));
const free = await (async () => {
  const { heading, body } = await headed(need(common, 'БЕЗПЛАТНО', '_shared'));
  return { heading, html: cleanHtml(await md(body)) };
})();
const deliver = await (async () => {
  const { heading, body } = await headed(need(common, 'ПОЛУЧАВАТЕ', '_shared'));
  return { heading, items: await parseRunIns(body) };
})();
const steps = await (async () => {
  const { heading, body } = await headed(need(common, 'СТЪПКИ', '_shared'));
  return { heading, items: await parseStepLines(body) };
})();
const whoWe = await columns(need(common, 'ПАРТНЬОР', '_shared'));
const proof = await (async () => {
  const { heading, body } = await headed(need(common, 'ДОКАЗАТЕЛСТВО', '_shared'));
  return { heading, lede: cleanHtml(await md(body)) };
})();
const sharedFaq = await (async () => {
  const { heading, body } = await headed(need(common, 'FAQ', '_shared'));
  return { heading, items: await parseFaq(body) };
})();
const faq = [...ownFaq, ...sharedFaq.items].map((q) => ({ question: q.question, answer: cleanHtml(q.answer) }));
const formBlock = await (async () => {
  const { heading, body } = await headed(need(common, 'ФОРМА', '_shared'));
  const paras = paragraphs(body);
  return {
    heading,
    lede: cleanHtml(await md(paras.slice(0, -1).join('\n\n'))),
    after: paras.length > 1 ? cleanHtml(await md(paras.at(-1)!)) : '',
  };
})();

// --- Лога: партньорът от clients.yaml и нашето ---
const clients = await getCollection('clients');
const partner = clients.find((c) => c.data.partner);
const partnerKey = partner?.data.name.replace(/\s*(ООД|ЕООД|АД|ЕАД)$/, '') ?? '';
const showPartnerLogo = partner && (!partner.data.placeholder || showPlaceholders);
const ourLogo = { src: '/img/logo.webp', alt: company.brand };
const clientBySlug = new Map(clients.map((c) => [c.id, c]));
const logoFor = (s?: string) => (s ? clientBySlug.get(s) : undefined);

// --- Доказателство: кейсове по програми (избрани във frontmatter или всички с program) ---
const allProjects = await getCollection('projects', (p) => p.id.startsWith('bg/'));
const projectSlug = (id: string) => id.replace(/^bg\/projects\//, '');
const wanted = entry.data.projects;
const projects = (wanted
  ? wanted.flatMap((s) => allProjects.filter((p) => projectSlug(p.id) === s))
  : allProjects.filter((p) => p.data.program)
).sort((a, b) => a.data.order - b.data.order);
const shots = (
  await Promise.all(
    projects.map(async (p) => {
      const img = p.data.images[0];
      if (!img || !publicFileExists(img.src)) return null;
      return { project: p, img, size: await publicImageSize(img.src) };
    }),
  )
).filter((x): x is NonNullable<typeof x> => x !== null);
const projectSlugs = new Set(projects.map((p) => projectSlug(p.id)));
const testimonials = (await getCollection('testimonials'))
  .filter((x) => projectSlugs.has(x.data.project) && (!x.data.placeholder || showPlaceholders))
  .slice(0, 2);

// --- Изображения от frontmatter (hero, банер) - до качване Placeholder „снимка“ ---
const image = entry.data.image && publicFileExists(entry.data.image.src)
  ? { ...entry.data.image, ...(await publicImageSize(entry.data.image.src)) }
  : null;
const banner = entry.data.banner && publicFileExists(entry.data.banner.src)
  ? { ...entry.data.banner, ...(await publicImageSize(entry.data.banner.src)) }
  : null;

const isLatin = (text: string) => /^[\x00-\x7F]*$/.test(text);
const { procedure, niche, status, deadline, facts, source } = entry.data;
const statusText = t(`campaign.status.${status}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: plainText(item.question),
    acceptedAnswer: { '@type': 'Answer', text: plainText(item.answer) },
  })),
};
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  noindex={entry.data.noindex}
  header={{ minimal: true, cta }}
>
  <script is:inline type="application/ld+json" slot="head" set:html={toJsonLd(jsonLd)} />

  <!-- HERO - текст 7/12 + снимка 5/12 (DESIGN.md §Вместо това); под тях числата на процедурата -->
  <section class="hero-band">
    <div class="wrap hero">
      <div class="hero-text">
        <p class="readout">
          {t('campaign.procedure')}{' '}<span class="mono">{procedure.code}</span> · {procedure.programme} ·{' '}
          {statusText}{deadline && status !== 'closed' && <> · {t('campaign.deadline')}{' '}{deadline}</>}
          {niche && <> · {t('campaign.niche')}{' '}{niche}</>}
        </p>
        <h1 set:html={hero.title} />
        <div class="lede prose" set:html={hero.lede} />
        <p class="hero-cta" data-cta-anchor>
          <a class="btn" href={cta.href}>{cta.text}</a>
          <a class="arrow-link" href="#how">{t('campaign.how')}</a>
        </p>
      </div>
      <div class="hero-media">
        {
          image ? (
            <img class="photo" src={image.src} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" />
          ) : (
            <Placeholder label={t('placeholder.photo')} caption={entry.data.image?.alt} variant="photo" ratio="4 / 3" />
          )
        }
      </div>

      {
        facts.length > 0 && (
          <div class="facts tile tile-surface" aria-label={t('campaign.facts')}>
            <dl>
              {facts.map((f) => (
                <div class="fact">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
            {source && (
              <p class="facts-source">
                <a class="arrow-link" href={source} rel="noopener" target="_blank">
                  {t('campaign.source')}
                </a>
              </p>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- РЕД ДОВЕРИЕ - логата на партньора и нашето + едно изречение -->
  <section class="section section-trust">
    <div class="wrap trust">
      <ul class="logos">
        {
          showPartnerLogo && (
            <li>
              {partner.data.placeholder ? (
                <>
                  <span class="mono">{partner.data.name}</span>
                  <span class="tag">{t('placeholder.sample')}</span>
                </>
              ) : (
                <img class="logo" src={partner.data.logo} alt={partner.data.name} height="36" loading="lazy" />
              )}
            </li>
          )
        }
        <li><img class="logo" src={ourLogo.src} alt={ourLogo.alt} height="36" loading="lazy" /></li>
      </ul>
      <p class="trust-line" set:html={trustLine} />
    </div>
  </section>

  <!-- ЗА КОГО - бяла плочка, две колони: „+“ за вас е, „–“ не е за вас -->
  {
    who && (
      <section class="section">
        <div class="wrap">
          <div class="tile tile-surface reveal who">
            <h2 class="centered" set:html={who.heading} />
            <div class="cols-2">
              {who.cols.map((c, i) => (
                <div class:list={['who-col', i === 0 ? 'yes' : 'no']}>
                  <h3 set:html={c.heading} />
                  <div class="prose" set:html={c.html} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- КАКВО СЕ ФИНАНСИРА - студена плочка; софтуерът е първата колона и е нашата част -->
  {
    funds && (
      <section class="section">
        <div class="wrap">
          <div class="tile tile-cool reveal funds">
            <h2 class="centered" set:html={funds.heading} />
            <div class="cols-2">
              {funds.cols.map((c, i) => (
                <div class:list={['funds-col', i === 0 && 'ours']}>
                  <h3 set:html={c.heading} />
                  <div class="prose" set:html={c.html} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ПРИМЕРИ - таблица дейност → какво се намалява и коя система го доказва („ръчна котва“) -->
  {
    examples && examples.items.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2 class="centered" set:html={examples.heading} />
          <table class="examples" role="table">
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">{t('campaign.examples.term')}</th>
                <th role="columnheader" scope="col">{t('campaign.examples.text')}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {examples.items.map((it) => (
                <tr role="row">
                  <th role="rowheader" scope="row" set:html={it.term} />
                  <td role="cell" set:html={it.text} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <!-- БАНЕР - широк кадър (реална снимка от производство/система); до качване - placeholder -->
  <section class="section">
    <div class="wrap">
      {
        banner ? (
          <img class="photo banner" src={banner.src} alt={banner.alt} width={banner.width} height={banner.height} loading="lazy" />
        ) : (
          <Placeholder label={t('campaign.banner')} caption={entry.data.banner?.alt} variant="photo" ratio="21 / 9" />
        )
      }
    </div>
  </section>

  <!-- НИЩО НЕ ПЛАЩАТЕ ДО ОДОБРЕНИЕ - плочка в accent-soft (единственият топъл акцент на страницата) -->
  <section class="section">
    <div class="wrap">
      <div class="tile free reveal">
        <div class="free-head">
          <h2 set:html={free.heading} />
        </div>
        <div class="free-body">
          <div class="prose" set:html={free.html} />
          <p class="free-cta">
            <a class="btn" href={cta.href}>{cta.text}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- КАКВО ПОЛУЧАВАТЕ - бяла плочка, run-in заглавия в две колони -->
  <section class="section">
    <div class="wrap">
      <div class="tile tile-surface reveal deliver">
        <h2 class="centered" set:html={deliver.heading} />
        <dl class="deliver-list">
          {
            deliver.items.map((it) => (
              <div class="deliver-item">
                <dt set:html={it.title} />
                <dd set:html={it.text} />
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- КАК СТАВА - топла плочка, 5 стъпки (Process.astro) -->
  <section class="section" id="how">
    <div class="wrap">
      <div class="tile tile-tint reveal process-tile">
        <h2 class="centered" set:html={steps.heading} />
        <Process items={steps.items} />
      </div>
    </div>
  </section>

  <!-- КОЙ СТОИ ЗАД ТОВА - бяла плочка, партньорът и ние, с лога и роли -->
  <section class="section">
    <div class="wrap">
      <div class="tile tile-surface reveal whowe">
        <h2 class="centered" set:html={whoWe.heading} />
        <div class="cols-2">
          {
            whoWe.cols.map((c) => {
              const isPartner = Boolean(partnerKey) && c.heading.includes(partnerKey);
              const logo = isPartner
                ? showPartnerLogo && !partner.data.placeholder
                  ? { src: partner.data.logo, alt: partner.data.name, url: partner.data.url }
                  : null
                : { src: ourLogo.src, alt: ourLogo.alt, url: localeUrl(locale, '/') };
              return (
                <div class="whowe-col">
                  {logo && (
                    <p class="whowe-logo">
                      {logo.url ? (
                        <a href={logo.url} rel={isPartner ? 'noopener' : undefined} target={isPartner ? '_blank' : undefined}>
                          <img src={logo.src} alt={isPartner ? `${logo.alt} – ${t('partner.site')}` : logo.alt} height="36" loading="lazy" />
                        </a>
                      ) : (
                        <img src={logo.src} alt={logo.alt} height="36" loading="lazy" />
                      )}
                    </p>
                  )}
                  <h3 set:html={c.heading} />
                  <div class="prose" set:html={c.html} />
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ДОКАЗАТЕЛСТВО - реални кадри в продуктови рамки, таблица на проектите по програми, отзив -->
  {
    projects.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2 class="centered" set:html={proof.heading} />
          <div class="proof-lede prose centered-text" set:html={proof.lede} />
          {shots.length > 0 && (
            <div class="shots">
              {shots.map(({ project, img, size }) => (
                <figure class="figure">
                  <div class="frame">
                    <div class:list={['frame-bar', isLatin(img.alt) && 'mono']}>{img.alt}</div>
                    <img class="frame-body" src={img.src} alt="" width={size.width} height={size.height} loading="lazy" />
                  </div>
                  <figcaption>
                    {cleanText(project.data.client)} · {cleanText(project.data.program)}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
          <table class="programs" role="table">
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">{t('facts.client')}</th>
                <th role="columnheader" scope="col">{t('facts.program')}</th>
                <th role="columnheader" scope="col">{t('facts.services')}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {projects.map((p) => (
                <tr role="row">
                  <td role="cell" class="client">
                    <a href={localeUrl(locale, `/projects/${projectSlug(p.id)}`)}>{cleanText(p.data.client)}</a>
                    {p.data.status === 'in-progress' && <span class="tag">{t('projects.inProgress')}</span>}
                  </td>
                  <td role="cell" class="program">{cleanText(p.data.program)}</td>
                  <td role="cell" class="services">{p.data.services.join(' · ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {testimonials.length > 0 && (
            <div class="quotes">
              {testimonials.map((x) => (
                <figure class="quote tile tile-surface reveal">
                  <blockquote>
                    <span class="open" aria-hidden="true">
                      „
                    </span>
                    <p>{x.data.quote}</p>
                  </blockquote>
                  <figcaption>
                    {logoFor(x.data.client) && !logoFor(x.data.client)!.data.placeholder && (
                      <img class="quote-logo" src={logoFor(x.data.client)!.data.logo} alt="" height="28" loading="lazy" />
                    )}
                    <span>
                      {x.data.name && <><span class="who">{x.data.name}</span>, </>}
                      {x.data.role}, {x.data.company}
                      {x.data.placeholder && <span class="tag">{t('placeholder.sample')}</span>}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- ЗАЩО СЕГА - студена плочка със сроковете на процедурата + CTA -->
  {
    whyNow && (
      <section class="section">
        <div class="wrap">
          <div class="tile tile-cool reveal why">
            <h2 set:html={whyNow.heading} />
            <div class="prose" set:html={whyNow.html} />
            <p class="why-cta">
              <a class="btn" href={cta.href}>{cta.text}</a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ - въпросите по процедурата, после общите; <details> както на /services -->
  <section class="section faq" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title" class="centered" set:html={sharedFaq.heading} />
      <div class="faq-list">
        {
          faq.map((item) => (
            <details>
              <summary set:html={item.question} />
              <div class="answer prose" set:html={item.answer} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- АНКЕТА - топла плочка: текст вляво, стъпковата анкета вдясно (EligibilitySurvey) -->
  <section class="section section-cta" id="form" data-cta-anchor>
    <div class="wrap">
      <div class="tile tile-tint reveal cta">
        <div class="cta-text">
          <h2 set:html={formBlock.heading} />
          <div class="prose" set:html={formBlock.lede} />
        </div>
        <div class="cta-form">
          <EligibilitySurvey locale={locale} campaign={campaignId} registeredBefore={entry.data.registeredBefore} submitText={cta.text}>
            {formBlock.after && <div slot="after" class="cta-after" set:html={formBlock.after} />}
          </EligibilitySurvey>
        </div>
      </div>
    </div>
  </section>

  <!-- Мобилно: CTA-то е винаги на екрана в лента долу; скрива се, когато формата се вижда. -->
  <div class="sticky-cta" data-sticky-cta>
    <a class="btn" href={cta.href}>{cta.text}</a>
  </div>
</Base>

<script>
  // Лентата с CTA на мобилно изчезва, докато на екрана е бутонът в hero-то или формата -
  // иначе стои върху тях. Без JS лентата просто стои.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const anchors = document.querySelectorAll<HTMLElement>('[data-cta-anchor]');
  if (bar && anchors.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
        bar.toggleAttribute('data-hidden', visible.size > 0);
      },
      { threshold: 0.1 },
    );
    anchors.forEach((el) => io.observe(el));
  }
</script>

