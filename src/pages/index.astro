---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Placeholder from '../components/Placeholder.astro';
import Portrait from '../components/Portrait.astro';
import Process from '../components/Process.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import HeroCollage from '../components/HeroCollage.astro';
import { company } from '../data/company';
import { useTranslations, type Locale } from '../i18n/utils';
import { publicFileExists, publicImageSize } from '../lib/assets';
import { toJsonLd } from '../lib/jsonld';
import {
  mdInline,
  parseHero,
  parseSection,
  parseServices,
  parseSteps,
  splitSections,
} from '../lib/markdown';

// Цялото съдържание идва от content/bg/home.md, нарязан по секционните коментари в него,
// плюс колекциите projects (featured), clients и testimonials. Нищо не е написано тук.
// Layout: DESIGN.md §Ревизия — продуктов лендинг с плочки върху хартия.
const locale: Locale = 'bg';
const t = useTranslations(locale);
const isProd = import.meta.env.PROD;
// SHOW_PLACEHOLDERS=1 npm run build → примерните отзиви/лога се виждат и в production build (за преглед).
const showPlaceholders = !isProd || process.env.SHOW_PLACEHOLDERS === '1';

const page = await getEntry('pages', 'bg/home');
if (!page) throw new Error('content/bg/home.md липсва');
const s = splitSections(page.body ?? '');
const get = (key: string) => {
  const v = s.get(key);
  if (v === undefined) throw new Error(`home.md: няма секция <!-- ${key} — ... -->`);
  return v;
};

const hero = await parseHero(get('HERO'));
const trust = await mdInline(get('ЛЕНТА ДОВЕРИЕ'));
const services = await parseServices(get('УСЛУГИ'));
const projectsSection = await parseSection(get('ИЗБРАНИ ПРОЕКТИ'));
const steps = await parseSteps(get('ПРОЦЕС'));
const testimonialsSection = await parseSection(get('ОТЗИВИ'));
const about = await parseSection(get('ЗА МЕН'));
const cta = await parseSection(get('CTA + МИНИ-ФОРМА'));
// Първият абзац стои над формата; останалите (контактният ред) — под бутона, през slot,
// за да не се показват два пъти (DESIGN.md §Форма).
const ctaParagraphs = cta.body.match(/<p>[\s\S]*?<\/p>/g) ?? [];
const ctaLede = ctaParagraphs[0] ?? '';
const ctaAfter = ctaParagraphs.slice(1).join('');

const featured = (await getCollection('projects', (p) => p.id.startsWith('bg/') && p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const slugOf = (id: string) => id.replace(/^bg\/projects\//, '');

// placeholder: true → в dev с етикет, в production се пропуска (CLAUDE.md §Правила 1).
const clients = (await getCollection('clients'))
  .filter((c) => !c.data.partner && (!c.data.placeholder || showPlaceholders))
  .slice(0, 6);
const testimonials = (await getCollection('testimonials'))
  .filter((x) => !x.data.placeholder || showPlaceholders)
  .slice(0, 3);
const clientBySlug = new Map((await getCollection('clients')).map((c) => [c.id, c]));
const logoFor = (slug?: string) => (slug ? clientBySlug.get(slug) : undefined);

// Hero визуалът е първият скрийншот на първия избран проект (Odoo CRM), както е в коментара.
const heroImage = featured[0]?.data.images[0];
const heroSize = heroImage && publicFileExists(heroImage.src) ? await publicImageSize(heroImage.src) : null;
// Колаж „работеща система“ (HeroCollage): таблото на Odoo + телефонът със Secret Bar + магазинът
// stegi.store. Пътищата са в коментара HERO на home.md; ако някой файл липсва — само таблото.
const collageSrc = {
  phone: '/img/projects/secret-bar/loyalty-phone.webp',
  shop: '/img/projects/stegi-store/home-card.webp',
};
const collage =
  heroImage && heroSize && publicFileExists(collageSrc.phone) && publicFileExists(collageSrc.shop)
    ? {
        back: { src: heroImage.src, ...heroSize, bar: heroImage.alt },
        phone: { src: collageSrc.phone, ...(await publicImageSize(collageSrc.phone)) },
        shop: { src: collageSrc.shop, ...(await publicImageSize(collageSrc.shop)), bar: 'stegi.store' },
      }
    : null;
// Реалните размери на първия кадър на всеки избран проект (за width/height на <img>).
const featuredSizes = await Promise.all(
  featured.map((p) => {
    const img = p.data.images[0];
    return img && publicFileExists(img.src) ? publicImageSize(img.src) : Promise.resolve(null);
  }),
);
// Късият ред над h1 (readout) е секцията „ЛЕНТА ДОВЕРИЕ“ от home.md; над логата няма текст.

const portrait = { src: '/img/marti.webp', alt: company.founder };
const isLatin = (text: string) => /^[\x00-\x7F]*$/.test(text);

const site = Astro.site?.href ?? 'https://pankovsolutions.com/';
const address = {
  '@type': 'PostalAddress',
  streetAddress: company.street,
  addressLocality: company.city,
  addressCountry: 'BG',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: company.brand,
      legalName: company.name,
      url: site,
      email: company.email,
      telephone: company.phone,
      taxID: company.eik,
      address,
      founder: { '@type': 'Person', name: company.founder },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}#service`,
      name: company.brand,
      url: site,
      description: page.data.description,
      email: company.email,
      telephone: company.phone,
      address,
      areaServed: { '@type': 'Country', name: 'България' },
      parentOrganization: { '@id': `${site}#organization` },
    },
  ],
};
---

<Base title={page.data.title} description={page.data.description} locale={locale}>
  <script is:inline type="application/ld+json" slot="head" set:html={toJsonLd(jsonLd)} />

  <!-- HERO — центриран, 80 px заглавие, кратък ред, CTA; визуалът в бяла плочка под тях -->
  <section class="hero-band">
    <div class="hero wrap">
      <div class="hero-text">
        <p class="readout" set:html={trust} />
        <h1 set:html={hero.title} />
        <div class="lede" set:html={hero.lede} />
        <p class="hero-cta">
          {hero.links[0] && <a class="btn" href={hero.links[0].href}>{hero.links[0].text}</a>}
          {hero.links[1] && <a class="arrow-link" href={hero.links[1].href}>{hero.links[1].text}</a>}
        </p>
      </div>
      <div class="hero-media tile tile-surface">
        {
          collage ? (
            <HeroCollage back={collage.back} phone={collage.phone} shop={collage.shop} locale={locale} />
          ) : heroImage && heroSize ? (
            <div class="frame">
              <div class="frame-bar">{heroImage.alt}</div>
              <img
                class="frame-body"
                src={heroImage.src}
                alt={heroImage.alt}
                width={heroSize.width}
                height={heroSize.height}
              />
            </div>
          ) : (
            <SystemDiagram />
          )
        }
      </div>
    </div>
  </section>

  <!-- КЛИЕНТИ — етикет + до 6 лога (без числа: с кого сме работили, не колко) -->
  {
    clients.length > 0 && (
  <section class="section section-clients">
    <div class="wrap">
      <div class="trust">
        <p class="trust-label" id="clients-label">{t('trust.clients')}</p>
        {
          clients.length > 0 && (
            <ul class="logos" aria-labelledby="clients-label">
              {clients.map((c) =>
                c.data.placeholder ? (
                  <li class="logo-ph">
                    <span class="mono">{c.data.name}</span>
                    <span class="tag">{t('placeholder.sample')}</span>
                  </li>
                ) : (
                  <li>
                    <img class="logo" src={c.data.logo} alt={c.data.name} height="36" loading="lazy" />
                  </li>
                ),
              )}
            </ul>
          )
        }
      </div>
    </div>
  </section>
    )
  }

  <!-- УСЛУГИ — три плочки: първата широка, две половинки; mono номер в охра, без икони -->
  <section class="section">
    <div class="wrap">
      <h2 class="centered" set:html={services.heading} />
      <ol class="services rail" id="services-rail">
        {
          services.items.map((item) => (
            <li class="tile tile-surface reveal">
              <span class="num" aria-hidden="true">
                {item.number}
              </span>
              <div class="service-body">
                <h3 set:html={item.title} />
                <p set:html={item.text} />
                {item.link && (
                  <a class="arrow-link" href={item.link.href}>
                    {item.link.text}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <div class="rail-nav" data-rail-nav="services-rail">
        <button type="button" class="rail-btn" data-dir="-1" aria-label={t('rail.prev')}>←</button>
        <button type="button" class="rail-btn" data-dir="1" aria-label={t('rail.next')}>→</button>
      </div>
    </div>
  </section>

  <!-- ИЗБРАНИ ПРОЕКТИ — плочка на проект, рамка + текст, редуване ляво/дясно -->
  <section class="section">
    <div class="wrap">
      <h2 class="centered" set:html={projectsSection.heading} />
      <div class="projects">
        {
          featured.map((p, i) => {
            const img = p.data.images[0];
            const size = featuredSizes[i];
            const href = `/projects/${slugOf(p.id)}`;
            return (
              <article class="project tile tile-surface reveal">
                <a class="media frame-link" href={href} tabindex="-1" aria-hidden="true">
                  {img && size ? (
                    <div class="frame">
                      <!-- Адресният ред е името на екрана/системата (alt); клиентът е в .meta до заглавието. -->
                      <div class:list={['frame-bar', isLatin(img.alt) && 'mono']}>{img.alt}</div>
                      <img class="frame-body" src={img.src} alt="" width={size.width} height={size.height} loading="lazy" />
                    </div>
                  ) : (
                    <Placeholder label={t('placeholder.screenshot')} caption={img?.alt} bar={p.data.client} ratio="16 / 10" />
                  )}
                </a>
                <div class="text">
                  <p class="meta">{p.data.client}</p>
                  <h3>
                    <a href={href} set:html={p.data.result} />
                  </h3>
                  <p class="mono stack">{p.data.stack.join(' · ')}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ПРОЦЕС — топла плочка с петте стъпки -->
  <section class="section">
    <div class="wrap">
      <div class="tile tile-tint reveal process-tile">
        <h2 class="centered" set:html={steps.heading} />
        <Process items={steps.items} />
      </div>
    </div>
  </section>

  <!-- ОТЗИВИ — пълен текст, име, длъжност, фирма; без снимки; максимум 3 -->
  {
    testimonials.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2 class="centered" set:html={testimonialsSection.heading} />
          <div class="quotes rail" id="quotes-rail">
            {testimonials.map((x) => (
              <figure class="quote tile tile-surface reveal">
                <blockquote>
                  <span class="open" aria-hidden="true">
                    „
                  </span>
                  <p>{x.data.quote}</p>
                </blockquote>
                <figcaption>
                  {logoFor(x.data.client) && !logoFor(x.data.client)!.data.placeholder && (
                    <img class="quote-logo" src={logoFor(x.data.client)!.data.logo} alt="" height="28" loading="lazy" />
                  )}
                  <span>
                    {x.data.name && <><span class="who">{x.data.name}</span>, </>}
                    {x.data.role}, {x.data.company}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class="rail-nav" data-rail-nav="quotes-rail">
            <button type="button" class="rail-btn" data-dir="-1" aria-label={t('rail.prev')}>←</button>
            <button type="button" class="rail-btn" data-dir="1" aria-label={t('rail.next')}>→</button>
          </div>
        </div>
      </section>
    )
  }

  <!-- ЗА МЕН — бяла плочка: портрет 4/12, текст 8/12 -->
  <section class="section">
    <div class="wrap">
      <div class="tile tile-surface reveal about">
        <div class="portrait">
          <Portrait src={portrait.src} alt={portrait.alt} locale={locale} />
        </div>
        <div class="about-text">
          <h2 set:html={about.heading} />
          <div class="prose" set:html={about.body} />
          {about.links[0] && <a class="arrow-link" href={about.links[0].href}>{about.links[0].text}</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA + МИНИ-ФОРМА — топла плочка -->
  <section class="section section-cta">
    <div class="wrap">
      <div class="tile tile-tint reveal cta">
        <div class="cta-text">
          <h2 set:html={cta.heading} />
          <div class="prose" set:html={ctaLede} />
        </div>
        <div class="cta-form">
          <InquiryForm locale={locale} variant="short">
            {ctaAfter && <div slot="after" class="cta-after" set:html={ctaAfter} />}
          </InquiryForm>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Лентите (услуги, отзиви) на мобилно: бутоните скролват с една плочка; в краищата се
  // изключват. Без JS остава swipe-ът (overflow-x: auto).
  for (const nav of document.querySelectorAll<HTMLElement>('[data-rail-nav]')) {
    const rail = document.getElementById(nav.dataset.railNav ?? '');
    if (!rail) continue;
    const btns = nav.querySelectorAll<HTMLButtonElement>('button[data-dir]');
    const step = () => (rail.firstElementChild as HTMLElement | null)?.offsetWidth ?? rail.clientWidth * 0.86;
    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth - 1;
      for (const b of btns) b.disabled = b.dataset.dir === '-1' ? rail.scrollLeft <= 0 : rail.scrollLeft >= max;
    };
    for (const b of btns) {
      b.addEventListener('click', () => rail.scrollBy({ left: Number(b.dataset.dir) * (step() + 16), behavior: 'smooth' }));
    }
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  .section {
    padding-block: var(--spacing-6);
  }

  .section h2 {
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 var(--spacing-8);
  }

  .section h2.centered {
    text-align: center;
  }

  .prose :global(p) {
    max-width: var(--measure);
    line-height: 1.6;
    margin: 0 0 var(--spacing-4);
  }

  /* Без page-load fade на hero-то: елемент, който тръгва от opacity 0, не е LCP кандидат
     и Lighthouse взема логото за LCP (с „песимистичния“ граф от всички шрифтове → 3 s). */
  .hero-band {
    background: var(--color-primary-soft);
  }

  .hero {
    padding-block: var(--spacing-12) var(--spacing-12);
    text-align: center;
  }

  .hero-text {
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* Градът е на български (body), стекът е латиница (mono). */
  .readout {
    margin: 0 0 var(--spacing-4);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* Body, не mono: над сгъвката се зареждат само двата preload-нати шрифта (FCP/LCP). */
  .readout :global(code) {
    font-family: inherit;
  }

  /* 36 px на мобилно: „документиран“ на 48 px е с 4 px по-широка от колоната на 390 px. */
  .hero h1 {
    font-size: var(--text-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--spacing-6);
  }

  .lede :global(p) {
    font-size: var(--text-base);
    line-height: 1.5;
    margin: 0 0 var(--spacing-6);
    color: var(--color-muted);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-6);
    margin: 0;
  }

  .hero-media {
    margin: var(--spacing-12) auto 0;
    padding: var(--spacing-4);
  }

  .media {
    display: block;
  }

  /* Клиенти — етикет + лога, центрирани */
  .section-clients {
    padding-block: var(--spacing-6) var(--spacing-2);
  }

  .trust {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-4);
    text-align: center;
  }

  .trust-label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  .trust-line :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--spacing-2) var(--spacing-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logo {
    display: block;
    height: var(--logo-height);
    width: auto;
  }

  .logo-ph {
    display: flex;
    gap: var(--spacing-2);
    align-items: baseline;
  }

  /* Услуги: плочки; номерът в охра на 28 px (над прага 3:1 за едър текст) */
  .services {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Мобилно: услугите и отзивите са хоризонтална лента (swipe + бутони), не колона.
     Пълна ширина до ръба на екрана, плочките „надничат“; snap на всяка. Десктоп връща grid. */
  .rail {
    display: flex;
    gap: var(--spacing-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(-1 * var(--spacing-6));
    padding-inline: var(--spacing-6);
    padding-bottom: var(--spacing-1);
    scroll-padding-inline: var(--spacing-6);
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail > * {
    flex: 0 0 min(86%, 22rem);
    scroll-snap-align: start;
  }

  .rail-nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-2);
    margin-top: var(--spacing-4);
  }

  .rail-btn {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1;
    cursor: pointer;
  }

  .rail-btn:disabled {
    color: var(--color-line);
    cursor: default;
  }

  /* align-content: start — иначе в двете половинки редовете се разтягат по височината на
     по-високата плочка и заглавието на по-късата пада с ~60 px под съседното. */
  .services li {
    display: grid;
    align-content: start;
    gap: var(--spacing-4);
  }

  .num {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-accent);
  }

  .services h3 {
    font-size: var(--text-md);
    line-height: 1.2;
    margin: 0 0 var(--spacing-3);
  }

  .services p {
    margin: 0 0 var(--spacing-4);
    line-height: 1.6;
    max-width: var(--measure);
  }

  /* Избрани проекти: плочка на проект, редуване */
  .projects {
    display: grid;
    gap: var(--spacing-4);
  }

  .project {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-6);
  }

  .project .media,
  .project .text {
    grid-column: 1 / -1;
  }

  .project h3 {
    font-size: var(--text-lg);
    line-height: 1.2;
    margin: 0 0 var(--spacing-3);
  }

  .project h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .project h3 a:hover {
    text-decoration: underline;
    text-underline-offset: var(--spacing-1);
    text-decoration-thickness: 1px;
  }

  .meta {
    margin: 0 0 var(--spacing-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .stack {
    margin: 0;
    color: var(--color-muted);
  }

  /* Процесът е в components/Process.astro (споделен с /services). */
  .process-tile h2 {
    margin-bottom: var(--spacing-8);
  }

  /* Отзиви — на мобилно .rail, на десктоп grid (по-долу). */

  /* За мен */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-6);
  }

  .portrait,
  .about-text {
    grid-column: 1 / -1;
  }

  .about-text h2 {
    margin-top: 0;
  }

  /* CTA + форма: текст вляво, форма вдясно на десктоп; едно под друго на мобилно. */
  /* На мобилно без column-gap: 11 × 32 px биха надхвърлили ширината на плочката. */
  .cta {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 0;
    row-gap: var(--spacing-8);
  }

  .cta-text,
  .cta-form {
    grid-column: 1 / -1;
  }

  .cta h2 {
    max-width: var(--measure);
