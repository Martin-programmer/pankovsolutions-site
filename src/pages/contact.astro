---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { type Locale } from '../i18n/utils';
import { md, mdInline, splitH2, takeHeading } from '../lib/markdown';
import { cleanHtml, warnTodos } from '../lib/todos';

// Само от content/bg/contact.md. Частта след <!-- InquiryForm --> до първото h2 е
// спецификация на формата (полета, бутон, текст при успех) — не се рендерира като текст;
// от нея се взима само изречението при успех. Секцията „Директно“ е проза вдясно.
const locale: Locale = 'bg';

const page = await getEntry('pages', 'bg/contact');
if (!page) throw new Error('content/bg/contact.md липсва');
warnTodos(page.filePath ?? page.id, page.body);

const { preface, sections } = splitH2(page.body ?? '');
const [intro, spec = ''] = preface.split(/<!--\s*InquiryForm[\s\S]*?-->/);
const { heading: h1, rest: ledeMd } = takeHeading(intro, 1);
const lede = cleanHtml(await md(ledeMd));
// Изречението при успех от spec-а („Успех: „…““) се ползва на /contact/sent (без JS); с JS
// формата показва ui.form.success с подставен имейл. spec-ът иначе не се рендерира.
void spec;

const aside = [];
for (const s of sections) {
  aside.push({ heading: await mdInline(s.heading), html: cleanHtml(await md(s.body)) });
}
---

<Base title={page.data.title} description={page.data.description} locale={locale}>
  <div class="wrap page">
    <header class="head">
      <h1 set:html={await mdInline(h1)} />
      <div class="prose lede" set:html={lede} />
    </header>

    <div class="cols">
      <div class="form-col tile tile-surface" id="inquiry">
        <InquiryForm locale={locale} variant="full" />
      </div>

      <aside class="direct tile tile-cool">
        {
          aside.map((s) => (
            <section>
              <h2 set:html={s.heading} />
              <div class="prose" set:html={s.html} />
            </section>
          ))
        }
      </aside>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--spacing-12) var(--spacing-24);
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--spacing-6);
  }

  .lede :global(p) {
    font-size: var(--text-base);
  }

  .head {
    margin-bottom: var(--spacing-12);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-12);
  }

  .form-col,
  .direct {
    grid-column: 1 / -1;
  }

  /* Студената плочка е с височината на съдържанието си, не на формата. */
  .direct {
    align-self: start;
  }

  .direct section + section {
    margin-top: var(--spacing-8);
  }

  .direct h2 {
    font-size: var(--text-lg);
    line-height: 1.25;
    margin: 0 0 var(--spacing-4);
  }

  .direct :global(ul) {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .direct :global(li) {
    padding-block: var(--spacing-3);
    margin: 0;
    border-bottom: 1px solid var(--color-line);
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .page {
      padding-block: var(--spacing-16) var(--spacing-24);
    }

    h1 {
      font-size: var(--text-3xl);
    }

    .cols {
      column-gap: var(--spacing-4);
    }

    .form-col {
      grid-column: 1 / span 8;
    }

    .direct {
      grid-column: 9 / span 4;
    }
  }
</style>
