---
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
import { localeUrl, useTranslations, type Locale } from '../i18n/utils';

// COPY.md §Микрокопи: „Тази страница не съществува. Вижте проектите или ми пишете.“
const locale: Locale = 'bg';
const t = useTranslations(locale);
---

<Base title={`${t('notfound.title')} - ${company.brand}`} locale={locale} noindex ogImage="/og/index.png">
  <div class="wrap outer">
    <div class="page tile tile-surface">
      <p class="mono code">404</p>
      <h1>{t('notfound.title')}</h1>
      <p class="lead">
        <a class="arrow-link" href={localeUrl(locale, '/projects')}>{t('notfound.projects')}</a>
        {' '}{t('notfound.or')}{' '}
        <a class="arrow-link" href={localeUrl(locale, '/contact')}>{t('notfound.write')}</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .outer {
    padding-block: var(--spacing-12) var(--spacing-24);
  }

  .page {
    max-width: calc(var(--measure) + 2 * var(--spacing-12));
  }

  .code {
    margin: 0 0 var(--spacing-4);
    color: var(--color-muted);
  }

  /* xl на мобилно: „съществува.“ не се побира на 294 px при 2xl. */
  h1 {
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--spacing-6);
  }

  .lead {
    font-size: var(--text-base);
    line-height: 1.6;
    margin: 0;
  }
</style>
