---
import { company } from '../data/company';
import { localeUrl, useTranslations, type Locale } from '../i18n/utils';

// Формата за запитване. Пълен вариант (/contact): 6 полета по content/bg/contact.md +
// съгласие; кратък (начална): име, имейл, фирма, съобщение + съгласие; lead (лендинги по
// процедури, docs/11): име, фирма, телефон, имейл, описание по избор + съгласие, плюс скрити
// campaign (от коя страница идва) и type=eu - влизат в имейла и Telegram. Backend:
// functions/api/inquiry.ts. Работи без JS (POST + 303 към /contact/sent); скриптът
// по-долу добавя fetch, грешки по поле и успех на място. Turnstile е единственият
// external скрипт и се зарежда само когато има TURNSTILE_SITE_KEY при build.
interface Props {
  locale: Locale;
  variant?: 'short' | 'full' | 'lead';
  successText?: string;
  // Само за variant="lead": стойността на скритото поле и текстът на бутона (CTA на лендинга).
  campaign?: string;
  submitText?: string;
}

const { locale, variant = 'short', successText, campaign = '', submitText } = Astro.props;
const t = useTranslations(locale);
const id = (name: string) => `inquiry-${variant}-${name}`;
// process.env първо: в Workers Builds променливите са в process.env, не в .env файл.
const siteKey = (process.env.TURNSTILE_SITE_KEY ?? import.meta.env.TURNSTILE_SITE_KEY ?? '') as string;
const success = successText ?? t('form.success');

const types = ['erp', 'eu', 'shop', 'app', 'other'] as const;
---

<form
  class="inquiry"
  method="post"
  action="/api/inquiry"
  novalidate={undefined}
  data-success={success}
  data-sending={t('form.sending')}
  data-error-network={t('form.error.network')}
>
  <input type="hidden" name="locale" value={locale} />
  <!-- Скриптът записва момента на зареждане; сървърът отхвърля submit под 3 s. -->
  <input type="hidden" name="ts" value="" />
  {
    variant === 'lead' && (
      <>
        <input type="hidden" name="campaign" value={campaign} />
        <input type="hidden" name="type" value="eu" />
      </>
    )
  }

  <p class="form-status" role="alert" tabindex="-1" hidden></p>

  <div class="field">
    <label for={id('name')}>{t('form.name')}</label>
    <input id={id('name')} name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" aria-describedby={id('name-error')} />
    <p class="error" id={id('name-error')} role="alert" hidden></p>
  </div>

  {
    variant === 'full' && (
      <div class="field">
        <label for={id('company')}>{t('form.company')}</label>
        <input id={id('company')} name="company" type="text" autocomplete="organization" maxlength="120" aria-describedby={id('company-error')} />
        <p class="error" id={id('company-error')} role="alert" hidden />
      </div>
    )
  }

  {
    variant === 'lead' && (
      <>
        <div class="field">
          <label for={id('company')}>{t('form.company.required')}</label>
          <input id={id('company')} name="company" type="text" autocomplete="organization" required maxlength="120" aria-describedby={id('company-error')} />
          <p class="error" id={id('company-error')} role="alert" hidden />
        </div>
        <div class="field">
          <label for={id('phone')}>{t('form.phone.required')}</label>
          <input id={id('phone')} name="phone" type="tel" autocomplete="tel" required maxlength="40" aria-describedby={id('phone-error')} />
          <p class="error" id={id('phone-error')} role="alert" hidden />
        </div>
      </>
    )
  }

  <div class="field">
    <label for={id('email')}>{t('form.email')}</label>
    <input id={id('email')} name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby={id('email-error')} />
    <p class="error" id={id('email-error')} role="alert" hidden></p>
  </div>

  {
    variant === 'full' ? (
      <>
        <div class="field">
          <label for={id('phone')}>{t('form.phone')}</label>
          <input id={id('phone')} name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby={id('phone-error')} />
          <p class="error" id={id('phone-error')} role="alert" hidden />
        </div>

        <div class="field">
          <label for={id('type')}>{t('form.type')}</label>
          <select id={id('type')} name="type" required aria-describedby={id('type-error')}>
            <option value="">{t('form.type.choose')}</option>
            {types.map((v) => (
              <option value={v}>{t(`form.type.${v}`)}</option>
            ))}
          </select>
          <p class="error" id={id('type-error')} role="alert" hidden />
        </div>
      </>
    ) : variant === 'short' ? (
      <div class="field">
        <label for={id('company')}>{t('form.company')}</label>
        <input id={id('company')} name="company" type="text" autocomplete="organization" maxlength="120" aria-describedby={id('company-error')} />
        <p class="error" id={id('company-error')} role="alert" hidden />
      </div>
    ) : null
  }

  <div class="field">
    <label for={id('message')}>{variant === 'lead' ? t('form.plan') : t('form.message')}</label>
    <textarea
      id={id('message')}
      name="message"
      rows="3"
      required={variant !== 'lead'}
      minlength={variant === 'lead' ? undefined : 10}
      maxlength="2000"
      aria-describedby={id('message-error')}
    ></textarea>
    <p class="error" id={id('message-error')} role="alert" hidden></p>
  </div>

  <div class="field check">
    <input id={id('consent')} name="consent" type="checkbox" required aria-describedby={id('consent-error')} />
    <label for={id('consent')}>
      {t('form.consent')}
      <a href={localeUrl(locale, '/privacy')}>{t('footer.privacy')}</a>
    </label>
    <p class="error" id={id('consent-error')} role="alert" hidden></p>
  </div>

  <!-- Honeypot: извън екрана (не display:none — четците да не го обявяват като скрито
       поле), извън tab реда; ботовете го попълват. -->
  <div class="hp" aria-hidden="true">
    <label for={id('website')}>{t('form.honeypot')}</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    siteKey && (
      <div class="turnstile">
        <div class="cf-turnstile" data-sitekey={siteKey} data-language={locale} />
        <p class="error" id={id('turnstile-error')} role="alert" hidden />
      </div>
    )
  }

  <button class="btn" type="submit">{submitText ?? t('form.submit')}</button>

  <!-- Редът под бутона (DESIGN.md §Форма). Страницата може да го подаде от content/ през
       slot „after“; иначе се ползва UI низът + данните от company.ts. -->
  <slot name="after">
    <p class="promise">
      {t('form.promise')}
      <a class="mono" href={company.phoneHref}>{company.phone}</a>&nbsp;·
      <a class="mono" href={`mailto:${company.email}`}>{company.email}</a>
    </p>
  </slot>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Progressive enhancement: fetch + грешки по поле + успех на място. Без него формата
  // прави обикновен POST и сървърът пренасочва към /contact/sent или /contact/error.
  declare global {
    interface Window {
      turnstile?: { reset: () => void };
    }
  }

  type Reply = { ok: boolean; message?: string; errors?: Record<string, string> };

  for (const form of document.querySelectorAll<HTMLFormElement>('form.inquiry')) {
    // С JS сървърът валидира и връща грешки по поле (микрокопитата от COPY.md); native
    // validation остава само без JS.
    form.noValidate = true;
    const ts = form.querySelector<HTMLInputElement>('input[name="ts"]');
    if (ts) ts.value = String(Date.now());

    const status = form.querySelector<HTMLElement>('.form-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.textContent ?? '';

    const clear = () => {
      if (status) {
        status.hidden = true;
        status.textContent = '';
      }
      for (const el of form.querySelectorAll<HTMLElement>('[aria-invalid]')) el.removeAttribute('aria-invalid');
      for (const p of form.querySelectorAll<HTMLElement>('.error')) {
        p.hidden = true;
        p.textContent = '';
      }
    };

    const showErrors = (reply: Reply) => {
      // Грешка за поле, което го няма в тази форма (напр. turnstile без виджет), отива в
      // общото съобщение - иначе потребителят не вижда нищо.
      const orphan: string[] = [];
      for (const [name, text] of Object.entries(reply.errors ?? {})) {
        const p = form.querySelector<HTMLElement>(`.error[id$="-${name}-error"]`);
        const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
        if (p) {
          p.textContent = text;
          p.hidden = false;
        } else {
          orphan.push(text);
        }
        input?.setAttribute('aria-invalid', 'true');
      }
      // Фокус на първото невалидно поле по реда в DOM, не по реда на сървъра.
      const first = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      // Общото съобщение: когато няма грешки по поле (мрежа, лимит) или грешката е без поле.
      const shown = Object.keys(reply.errors ?? {}).length - orphan.length;
      if (status && (shown === 0 || orphan.length)) {
        status.textContent = orphan[0] ?? reply.message ?? form.dataset.errorNetwork ?? '';
        status.hidden = false;
      }
      (first ?? status)?.focus?.();
      window.turnstile?.reset();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clear();
      if (button) {
        button.disabled = true;
        button.textContent = form.dataset.sending ?? label;
      }
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const reply = (await res.json()) as Reply;
        if (reply.ok) {
          const done = document.createElement('p');
          done.className = 'form-success';
          done.setAttribute('role', 'status');
          done.tabIndex = -1;
          const email = form.querySelector<HTMLInputElement>('[name="email"]')?.value.trim() ?? '';
          done.textContent = (form.dataset.success ?? '').replace('{email}', email);
          form.replaceChildren(done);
          done.focus();
          return;
        }
        showErrors(reply);
      } catch {
        showErrors({ ok: false });
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
      }
    });
  }
</script>

<style>
  .inquiry {
    max-width: var(--measure);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    margin-bottom: var(--spacing-4);
  }

  label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    /* ≥ 44 px високи полета на мобилно. */
    padding: var(--spacing-3) var(--spacing-4);
    width: 100%;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-ink);
  }

  [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  /* Ред ≥ 44 px: етикетът е кликаем по цялата си височина. */
  .check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--spacing-1) var(--spacing-2);
    align-items: start;
    min-height: calc(var(--spacing-8) + var(--spacing-3));
  }

  .check input {
    width: var(--spacing-4);
    height: var(--spacing-4);
    margin-top: var(--spacing-1);
    accent-color: var(--color-primary);
    padding: 0;
  }

  .check label {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-muted);
    line-height: 1.6;
    padding-block: var(--spacing-2);
    margin-block: calc(-1 * var(--spacing-2));
  }

  /* Линк в текстов блок — подчертан, не само по цвят (WCAG 1.4.1). */
  .check label a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: var(--spacing-1);
    text-decoration-thickness: 1px;
  }

  .check label a {
    color: var(--color-primary);
  }

  .check .error {
    grid-column: 2;
  }

  .error,
  .form-status {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-error);
    line-height: 1.5;
  }

  .form-status {
    margin-bottom: var(--spacing-4);
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px solid var(--color-error);
  }

  /* Успех: цял блок на мястото на формата. */
  .inquiry :global(.form-success) {
    margin: 0;
    padding: var(--spacing-4) var(--spacing-6);
    background: var(--color-accent-soft);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  /* Honeypot: извън екрана, в DOM-а. */
  .hp {
    position: absolute;
    inset-inline-start: -200vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .turnstile {
    margin-bottom: var(--spacing-4);
  }

  .promise {
    margin: var(--spacing-4) 0 0;
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* Телефонът не се чупи по средата на номера; зона за докосване ≥ 44 px без да мести реда. */
  .promise a {
    display: inline-block;
    padding-block: var(--spacing-3);
    margin-block: calc(-1 * var(--spacing-3));
    color: var(--color-primary);
    white-space: nowrap;
  }
</style>
