---
import { company } from '../data/company';
import { languages, locales } from '../i18n/ui';
import { alternateUrl, localeUrl, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const alt = alternateUrl(locale, Astro.url.pathname);

const nav = [
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.services', path: '/services' },
  { key: 'nav.beneficiaries', path: '/for-beneficiaries' },
  { key: 'nav.products', path: '/products' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
] as const;

const social = [
  { label: 'LinkedIn', href: company.linkedin },
  { label: 'GitHub', href: company.github },
].filter((s): s is { label: string; href: string } => Boolean(s.href));

// Статичен build: годината е годината на последния build.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <section aria-labelledby="footer-company">
        <h2 id="footer-company" class="col-title">{t('footer.company')}</h2>
        <p class="legal-name">{company.name}</p>
        <p class="mono">{t('footer.eik')} {company.eik}</p>
        {company.vat && <p class="mono">{t('footer.vat')} {company.vat}</p>}
        <p>{company.address}</p>
        <p><a class="mono" href={company.phoneHref}>{company.phone}</a></p>
        <p><a class="mono" href={`mailto:${company.email}`}>{company.email}</a></p>
      </section>

      <nav aria-labelledby="footer-nav">
        <h2 id="footer-nav" class="col-title">{t('footer.nav')}</h2>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={localeUrl(locale, item.path)}>{t(item.key)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section aria-labelledby="footer-languages">
        <h2 id="footer-languages" class="col-title">{t('footer.languages')}</h2>
        <ul>
          {
            locales.map((code) => (
              <li>
                {code === locale ? (
                  <span aria-current="true" lang={code}>
                    {languages[code].name}
                  </span>
                ) : (
                  <a href={alt.href} hreflang={code} lang={code}>
                    {languages[code].name}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        {
          social.length > 0 && (
            <ul class="social">
              {social.map((s) => (
                <li>
                  <a href={s.href} rel="me">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <!-- TODO: Марти да даде: LinkedIn и GitHub URL в src/data/company.ts — дотогава блокът е празен. -->
      </section>
    </div>

    <p class="colophon mono">
      © {year} {company.name} · <a href={localeUrl(locale, '/privacy')}>{t('footer.privacy')}</a> ·
      <!-- TODO: страница /accessibility (CHECKLIST §E, кратка декларация за достъпност) -->
      <a href={localeUrl(locale, '/accessibility')}>{t('footer.accessibility')}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    margin-top: var(--spacing-24);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .wrap {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--spacing-12) var(--spacing-6);
  }

  .cols {
    display: grid;
    gap: var(--spacing-8);
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-12);
    }
  }

  /* Заглавията на колоните наследяват serif 700 от tokens.css (CHECKLIST §A: заглавия
     само 700/300). Не са mono: mono-то няма български форми, а „Навигация“ и „Езици“
     са с малки букви. */
  .col-title {
    font-size: var(--text-sm);
    letter-spacing: 0;
    color: var(--color-muted);
    margin: 0 0 var(--spacing-3);
  }

  p {
    margin: 0 0 var(--spacing-1);
  }

  .legal-name {
    font-weight: 600;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin-bottom: var(--spacing-1);
  }

  .social {
    margin-top: var(--spacing-4);
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .colophon {
    margin-top: var(--spacing-12);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }
</style>
