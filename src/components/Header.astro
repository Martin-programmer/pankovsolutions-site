---
import { getCollection } from 'astro:content';
import { company } from '../data/company';
import { languages, locales } from '../i18n/ui';
import { alternateUrl, localeUrl, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.services', path: '/services' },
  { key: 'nav.beneficiaries', path: '/for-beneficiaries' },
  { key: 'nav.products', path: '/products' },
  { key: 'nav.about', path: '/about' },
] as const;

const pathname = Astro.url.pathname;
const alt = alternateUrl(locale, pathname);
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);

// Превключвателят показва EN само когато има EN съдържание в content/ - иначе линкът води
// към 404 (Base.astro прави същото за hreflang).
const hasEn = (await getCollection('pages', (e) => e.id.startsWith('en/'))).length > 0;
const shownLocales = locales.filter((code) => code === locale || hasEn);
---

<header class="site-header">
  <div class="bar">
    <!-- Логото е WebP @2x (public/img/logo.webp; източник design/logo/): знакът има преливане
         петрол→охра, което SVG в два цвята губи. Знакът сам е SVG (favicon, logo-mark). -->
    <a class="brand" href={localeUrl(locale, '/')}>
      <img src="/img/logo.webp" alt={company.brand} width="284" height="96" />
    </a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-list"
      data-label-open={t('menu')}
      data-label-close={t('menu.close')}
    >
      {t('menu')}
    </button>

    <nav class="site-nav" aria-label={t('nav.label')}>
      <ul id="site-nav-list" class="nav-list">
        {
          nav.map((item) => {
            const href = localeUrl(locale, item.path);
            return (
              <li>
                <a class="nav-link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
        <li class="nav-cta">
          <a class="btn" href={localeUrl(locale, '/contact')}>{t('cta.inquiry')}</a>
        </li>
        <!-- Превключвателят има смисъл само при два езика; сам „BG“ е мъртъв елемент. -->
        {shownLocales.length > 1 && (
        <li class="nav-lang">
          {
            shownLocales.map((code, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                {code === locale ? (
                  <span aria-current="true" lang={code}>
                    {languages[code].label}
                  </span>
                ) : (
                  <a href={alt.href} hreflang={code} lang={code} aria-label={languages[code].name}>
                    {languages[code].label}
                  </a>
                )}
              </>
            ))
          }
        </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<!-- Без JS менюто се показва разгънато, вместо да е недостъпно. -->
<noscript>
  <style is:inline>
    .nav-list {
      display: flex !important;
      flex-direction: column;
    }
  </style>
</noscript>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const list = document.getElementById('site-nav-list');

  function setOpen(open: boolean) {
    if (!btn) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? btn.textContent;
    list?.toggleAttribute('data-open', open);
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });

  // Reveal на плочките при скрол (DESIGN.md §Ревизия) — веднъж, без библиотеки. Живее тук,
  // а не в Base, за да е един скрипт-файл на страница (една заявка по-малко преди FCP).
  if ('IntersectionObserver' in window) {
    const tiles = document.querySelectorAll('.reveal');
    if (tiles.length) {
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      tiles.forEach((el) => io.observe(el));
    }
  }
</script>

<style>
  /* Без sticky, без blur, без сянка — само 1px долна линия. */
  /* Тънък sticky хедър (DESIGN.md §Ревизия) — плътен фон, без blur. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }

  .bar {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--spacing-4) var(--spacing-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4) var(--spacing-8);
  }

  /* 40 px на мобилно, 48 px на десктоп; ширината следва от пропорцията на файла (284:96). */
  /* Вертикален padding + отрицателен margin: зона за докосване 48 px (логото е 40 px на
     мобилно), без да мести реда. */
  .brand {
    display: block;
    line-height: 0;
    padding-block: var(--spacing-1);
    margin-block: calc(-1 * var(--spacing-1));
  }

  .brand img {
    display: block;
    height: 40px;
    width: auto;
  }

  .menu-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    /* ≥ 44 px зона за докосване. */
    padding: var(--spacing-3) var(--spacing-4);
    cursor: pointer;
  }

  .site-nav {
    flex-basis: 100%;
  }

  /* Мобилно: скрит списък, показва се без анимация през data-open (aria-expanded на бутона). */
  .nav-list {
    display: none;
    flex-direction: column;
    margin: 0;
    padding: var(--spacing-2) 0 var(--spacing-4);
    list-style: none;
  }

  .nav-list[data-open] {
    display: flex;
  }

  /* Мобилно: блок с вертикален padding → зона за докосване ≥ 44 px; без underline-slide. */
  .nav-link {
    position: relative;
    display: block;
    padding-block: var(--spacing-3);
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav-link[aria-current='page'] {
    font-weight: 600;
  }

  /* Underline-slide: псевдоелемент със scaleX, без градиент. */
  .nav-link::after {
    content: '';
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--spacing-1));
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease-out;
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* .btn и .mono са глобални (components.css) — една дефиниция, един размер на бутона. */
  /* Body, не mono: mono шрифтът да не е в критичния път на всяка страница (FCP). */
  .nav-lang {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  /* Подчертан: линк в текстов блок („BG · EN“) не бива да се различава само по цвят (WCAG 1.4.1). */
  .nav-lang a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: var(--spacing-1);
    text-decoration-thickness: 1px;
  }

  .nav-lang [aria-current] {
    color: var(--color-muted);
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .brand img {
      height: 48px;
    }

    .menu-btn {
      display: none;
    }

    .site-nav {
      flex-basis: auto;
    }

    .nav-list {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-6);
      padding: 0;
    }

    .nav-link {
      display: inline-block;
      padding-block: 0;
    }

    .nav-link::after {
      display: block;
    }

    .nav-cta {
      margin-left: var(--spacing-4);
    }
  }
</style>
