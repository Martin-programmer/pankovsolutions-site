---
import { company } from '../data/company';
import { languages, locales } from '../i18n/ui';
import { alternateUrl, localeUrl, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.services', path: '/services' },
  { key: 'nav.beneficiaries', path: '/for-beneficiaries' },
  { key: 'nav.products', path: '/products' },
  { key: 'nav.about', path: '/about' },
] as const;

const pathname = Astro.url.pathname;
const alt = alternateUrl(locale, pathname);
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="bar">
    <!-- TODO: Марти да даде: SVG лого; дотогава wordmark в Source Serif 700. -->
    <a class="wordmark" href={localeUrl(locale, '/')}>{company.brand}</a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav-list">
      {t('menu')}
    </button>

    <nav class="site-nav" aria-label={t('nav.label')}>
      <ul id="site-nav-list" class="nav-list">
        {
          nav.map((item) => {
            const href = localeUrl(locale, item.path);
            return (
              <li>
                <a class="nav-link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
        <li class="nav-cta">
          <a class="btn" href={localeUrl(locale, '/contact')}>{t('cta.inquiry')}</a>
        </li>
        <li class="nav-lang mono">
          {
            locales.map((code, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                {code === locale ? (
                  <span aria-current="true" lang={code}>
                    {languages[code].label}
                  </span>
                ) : (
                  <a href={alt.href} hreflang={code} lang={code} aria-label={languages[code].name}>
                    {languages[code].label}
                  </a>
                )}
              </>
            ))
          }
        </li>
      </ul>
    </nav>
  </div>
</header>

<!-- Без JS менюто се показва разгънато, вместо да е недостъпно. -->
<noscript>
  <style is:inline>
    .nav-list {
      display: flex !important;
      flex-direction: column;
    }
  </style>
</noscript>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const list = document.getElementById('site-nav-list');

  function setOpen(open: boolean) {
    btn?.setAttribute('aria-expanded', String(open));
    list?.toggleAttribute('data-open', open);
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });
</script>

<style>
  /* Без sticky, без blur, без сянка — само 1px долна линия. */
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }

  .bar {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--spacing-4) var(--spacing-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4) var(--spacing-8);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .menu-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: var(--spacing-2) var(--spacing-4);
    cursor: pointer;
  }

  .site-nav {
    flex-basis: 100%;
  }

  /* Мобилно: скрит списък, показва се без анимация през data-open (aria-expanded на бутона). */
  .nav-list {
    display: none;
    flex-direction: column;
    gap: var(--spacing-4);
    margin: 0;
    padding: var(--spacing-2) 0 var(--spacing-4);
    list-style: none;
  }

  .nav-list[data-open] {
    display: flex;
  }

  .nav-link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav-link[aria-current='page'] {
    font-weight: 600;
  }

  /* Underline-slide: псевдоелемент със scaleX, без градиент. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease-out;
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .btn {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-surface);
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    padding: var(--spacing-2) var(--spacing-4);
    text-decoration: none;
    transition: background-color 120ms ease-out;
  }

  .btn:hover {
    background: var(--color-primary-strong);
    border-color: var(--color-primary-strong);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .nav-lang a {
    color: var(--color-primary);
  }

  .nav-lang [aria-current] {
    color: var(--color-muted);
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .menu-btn {
      display: none;
    }

    .site-nav {
      flex-basis: auto;
    }

    .nav-list {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-6);
      padding: 0;
    }

    .nav-cta {
      margin-left: var(--spacing-4);
    }
  }
</style>
