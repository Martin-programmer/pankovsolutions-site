---
// „Процес: 5 стъпки в един хоризонтален ред на десктоп (номер mono + 1 изречение),
// вертикален на мобилно“ — DESIGN.md §Вместо това. Ползва се на началната и в /services.
interface Props {
  items: Array<{ number: string; title: string; text: string }>;
}

const { items } = Astro.props;
---

<ol class="steps">
  {
    items.map((step) => (
      <li>
        <span class="step-badge" aria-hidden="true">{Number(step.number)}</span>
        <h3 set:html={step.title} />
        {step.text && <p set:html={step.text} />}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--spacing-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Мобилно: вертикален списък, баджът над заглавието, без линии. */
  .steps li {
    position: relative;
    padding-top: var(--spacing-1);
  }

  .steps .step-badge {
    position: relative;
    z-index: 1;
  }

  /* Наследява serif 700 от tokens.css (CHECKLIST §A: заглавия само 700/300). */
  h3 {
    font-size: var(--text-base);
    text-wrap: pretty;
    margin: var(--spacing-3) 0 var(--spacing-1);
  }

  p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* = --breakpoint-md в tokens.css */
  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    /* Десктоп: баджовете са свързани с тънка линия през средата им - стъпките се четат
       като път. Линията минава зад баджа (z-index); при последния спира на баджа. */
    .steps li::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      /* Средата на баджа (40 px): padding 4 + 20. */
      top: calc(var(--spacing-1) + var(--spacing-4) + var(--spacing-1));
      height: 1px;
      background: var(--color-line);
    }

    .steps li:last-child::before {
      right: auto;
      width: calc(var(--spacing-4) + var(--spacing-1));
    }
  }
</style>
