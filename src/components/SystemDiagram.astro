---
// Системна схема — големият „продуктов“ визуал на hero-то (DESIGN.md §Ревизия): реалният
// стек от кейсовете — WooCommerce ↔ Odoo ↔ Metabase / Moodle / Telegram — върху Hetzner VPS.
// Inline SVG с токените; в възлите има wireframe линии (без текст/числа — нищо измислено);
// по линиите се движат пакети данни в охра (SMIL animateMotion; скрити при reduced-motion).
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

type Node = { id: string; x: number; y: number; w: number; h: number; title: string; sub: string; main?: boolean };
const nodes: Node[] = [
  { id: 'shop', x: 48, y: 72, w: 216, h: 96, title: 'WooCommerce', sub: 'онлайн магазин' },
  { id: 'odoo', x: 372, y: 148, w: 216, h: 144, title: 'Odoo', sub: 'CRM · ERP · склад', main: true },
  { id: 'bi', x: 696, y: 72, w: 216, h: 96, title: 'Metabase', sub: 'BI табла' },
  { id: 'lms', x: 696, y: 272, w: 216, h: 96, title: 'Moodle', sub: 'обучение на екипа' },
  { id: 'tg', x: 48, y: 272, w: 216, h: 96, title: 'Telegram', sub: 'известия' },
];
const center = { x: 372 + 108, y: 148 + 72 };
const edges = nodes
  .filter((n) => !n.main)
  .map((n, i) => {
    const from = { x: n.x + n.w / 2, y: n.y + n.h / 2 };
    const reverse = i % 2 === 1;
    return {
      id: `edge-${n.id}`,
      d: `M ${from.x} ${from.y} L ${center.x} ${center.y}`,
      begin: `${i * 0.9}s`,
      reverse,
      // Начална позиция на пакета преди анимацията — иначе стои в (0,0) в ъгъла.
      start: reverse ? center : from,
    };
  });
---

<svg
  class:list={['diagram', cls]}
  viewBox="0 0 960 440"
  role="img"
  aria-labelledby="diagram-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="diagram-title">Схема на типична система: WooCommerce, Odoo, Metabase, Moodle и Telegram на Hetzner VPS</title>

  <rect class="host" x="16" y="16" width="928" height="408" />
  <text class="host-label" x="32" y="412">Hetzner VPS · собствен сървър на клиента след приемане</text>

  {edges.map((e) => <path id={e.id} class="edge" d={e.d} />)}

  {
    edges.map((e) => (
      <circle class="packet" r="5" cx={e.start.x} cy={e.start.y}>
        <animateMotion dur="3.6s" repeatCount="indefinite" begin={e.begin} keyPoints={e.reverse ? '1;0' : '0;1'} keyTimes="0;1" calcMode="linear">
          <mpath href={`#${e.id}`} />
        </animateMotion>
      </circle>
    ))
  }

  {
    nodes.map((n) => (
      <g class:list={['node', n.main && 'main']}>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} />
        <text class="title" x={n.x + 20} y={n.y + 32}>
          {n.title}
        </text>
        <text class="sub" x={n.x + 20} y={n.y + 52}>
          {n.sub}
        </text>
        {/* wireframe редове — интерфейс без съдържание */}
        <rect class="wire" x={n.x + 20} y={n.y + (n.main ? 76 : 68)} width={n.w * 0.62} height="6" />
        <rect class="wire" x={n.x + 20} y={n.y + (n.main ? 92 : 80)} width={n.w * 0.38} height="6" />
        {n.main && <rect class="wire" x={n.x + 20} y={n.y + 108} width={n.w * 0.5} height="6" />}
      </g>
    ))
  }
</svg>

<style>
  .diagram {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }

  .host {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1;
    stroke-dasharray: 4 6;
  }

  .host-label {
    fill: var(--color-muted);
    font-size: 12px;
  }

  .edge {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1;
  }

  .packet {
    fill: var(--color-accent);
  }

  /* Едно от движенията в бюджета; при reduced-motion пакетите не се показват. */
  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
  }

  .node rect {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .node.main rect {
    fill: var(--color-primary);
    stroke: var(--color-primary);
  }

  .node .title {
    fill: var(--color-ink);
    font-size: 18px;
    font-weight: 700;
  }

  .node .sub {
    fill: var(--color-muted);
    font-family: var(--font-body);
    font-size: 13px;
  }

  .node .wire {
    fill: var(--color-line);
    stroke: none;
  }

  .node.main .title {
    fill: var(--color-paper);
    font-size: 24px;
  }

  .node.main .sub {
    fill: var(--color-accent-soft);
  }

  .node.main .wire {
    fill: var(--color-primary-strong);
  }
</style>
