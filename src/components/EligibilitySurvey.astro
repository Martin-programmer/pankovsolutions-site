---
import { company } from '../data/company';
import { localeUrl, useTranslations, type Locale } from '../i18n/utils';

// Стъпкова анкета за допустимост - само на лендингите по процедури (docs/11); няма общо с
// InquiryForm. Пет стъпки: регистрация преди срока (при „не“ - неподходяща) → персонал и
// приходи → фирма, ЕИК, населено място → дейност и какво ще се финансира → име, имейл,
// телефон, съгласие. Всички полета са задължителни. Backend: functions/api/survey.ts.
// След всяка завършена стъпка скриптът праща частичните отговори (event=step) - Марти вижда
// докъде стигат хората и къде спират. Без JS: всички стъпки са видими, обикновен POST.
interface Props {
  locale: Locale;
  campaign: string;
  // Датата от условията на процедурата („31.12.2023 г.“) - въпрос 1.
  registeredBefore: string;
  submitText: string;
}

const { locale, campaign, registeredBefore, submitText } = Astro.props;
const t = useTranslations(locale);
const id = (name: string) => `survey-${name}`;
const siteKey = (process.env.TURNSTILE_SITE_KEY ?? import.meta.env.TURNSTILE_SITE_KEY ?? '') as string;

const staff = ['lt10', '10-50', '50-250', 'gt250'] as const;
const revenue = ['lt100k', '100k-150k', '150k-400k', 'gt400k'] as const;
const TOTAL = 5;
const steps = Array.from({ length: TOTAL }, (_, i) => i + 1);
---

<form
  class="survey"
  method="post"
  action="/api/survey"
  data-total={TOTAL}
  data-success={t('survey.success')}
  data-sending={t('form.sending')}
  data-error-network={t('form.error.network')}
  data-step-label={t('survey.step')}
  data-sitekey={siteKey || undefined}
  data-locale={locale}
>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="campaign" value={campaign} />
  <input type="hidden" name="session" value="" />
  <input type="hidden" name="event" value="submit" />
  <input type="hidden" name="step" value={TOTAL} />
  <!-- Скриптът записва момента на зареждане; сървърът отхвърля submit под 3 s. -->
  <input type="hidden" name="ts" value="" />

  <p class="progress" data-progress hidden>
    <span class="progress-text" data-progress-text></span>
    <span class="bars" aria-hidden="true">
      {steps.map((n) => <span class="bar" data-bar={n} />)}
    </span>
  </p>

  <p class="form-status" role="alert" tabindex="-1" hidden></p>

  <!-- 1. Регистрация преди срока -->
  <fieldset data-step="1">
    <legend>{t('survey.registered').replace('{date}', registeredBefore)}</legend>
    <div class="choices" role="radiogroup" aria-describedby={id('registered-error')}>
      <label class="choice">
        <input type="radio" name="registered" value="yes" required />
        <span>{t('survey.yes')}</span>
      </label>
      <label class="choice">
        <input type="radio" name="registered" value="no" />
        <span>{t('survey.no')}</span>
      </label>
    </div>
    <p class="error" id={id('registered-error')} role="alert" hidden data-msg={t('survey.error.registered')}></p>
    <p class="ineligible" role="status" hidden data-ineligible>
      {t('survey.ineligible')}
      <a class="mono" href={company.phoneHref}>{company.phone}</a>
    </p>
  </fieldset>

  <!-- 2. Персонал и приходи -->
  <fieldset data-step="2">
    <legend class="sr-only">{t('survey.step').replace('{n}', '2').replace('{total}', String(TOTAL))}</legend>
    <div class="field">
      <label for={id('staff')}>{t('survey.staff')}</label>
      <select id={id('staff')} name="staff" required aria-describedby={id('staff-error')}>
        <option value="">{t('survey.choose')}</option>
        {staff.map((v) => <option value={v}>{t(`survey.staff.${v}`)}</option>)}
      </select>
      <p class="error" id={id('staff-error')} role="alert" hidden data-msg={t('survey.error.staff')}></p>
    </div>
    <div class="field">
      <label for={id('revenue')}>{t('survey.revenue')}</label>
      <select id={id('revenue')} name="revenue" required aria-describedby={id('revenue-error')}>
        <option value="">{t('survey.choose')}</option>
        {revenue.map((v) => <option value={v}>{t(`survey.revenue.${v}`)}</option>)}
      </select>
      <p class="error" id={id('revenue-error')} role="alert" hidden data-msg={t('survey.error.revenue')}></p>
    </div>
  </fieldset>

  <!-- 3. Фирма -->
  <fieldset data-step="3">
    <legend class="sr-only">{t('survey.step').replace('{n}', '3').replace('{total}', String(TOTAL))}</legend>
    <div class="field">
      <label for={id('company')}>{t('survey.company')}</label>
      <input id={id('company')} name="company" type="text" autocomplete="organization" required minlength="2" maxlength="120" aria-describedby={id('company-error')} />
      <p class="error" id={id('company-error')} role="alert" hidden data-msg={t('survey.error.company')}></p>
    </div>
    <div class="field">
      <label for={id('eik')}>{t('survey.eik')}</label>
      <input id={id('eik')} name="eik" type="text" inputmode="numeric" required pattern="[0-9]{9}([0-9]{4})?" maxlength="13" aria-describedby={id('eik-error')} />
      <p class="error" id={id('eik-error')} role="alert" hidden data-msg={t('survey.error.eik')}></p>
    </div>
    <div class="field">
      <label for={id('city')}>{t('survey.city')}</label>
      <input id={id('city')} name="city" type="text" autocomplete="address-level2" required minlength="2" maxlength="80" aria-describedby={id('city-error')} />
      <p class="error" id={id('city-error')} role="alert" hidden data-msg={t('survey.error.city')}></p>
    </div>
  </fieldset>

  <!-- 4. Дейност и инвестиция -->
  <fieldset data-step="4">
    <legend class="sr-only">{t('survey.step').replace('{n}', '4').replace('{total}', String(TOTAL))}</legend>
    <div class="field">
      <label for={id('activity')}>{t('survey.activity')}</label>
      <input id={id('activity')} name="activity" type="text" required minlength="3" maxlength="200" aria-describedby={id('activity-error')} />
      <p class="error" id={id('activity-error')} role="alert" hidden data-msg={t('survey.error.activity')}></p>
    </div>
    <div class="field">
      <label for={id('description')}>{t('survey.description')}</label>
      <textarea id={id('description')} name="description" rows="3" required minlength="10" maxlength="1000" aria-describedby={id('description-error')}></textarea>
      <p class="error" id={id('description-error')} role="alert" hidden data-msg={t('survey.error.description')}></p>
    </div>
  </fieldset>

  <!-- 5. Контакт -->
  <fieldset data-step="5">
    <legend class="sr-only">{t('survey.step').replace('{n}', '5').replace('{total}', String(TOTAL))}</legend>
    <div class="field">
      <label for={id('name')}>{t('form.name')}</label>
      <input id={id('name')} name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" aria-describedby={id('name-error')} />
      <p class="error" id={id('name-error')} role="alert" hidden data-msg={t('error.name')}></p>
    </div>
    <div class="field">
      <label for={id('email')}>{t('form.email')}</label>
      <input id={id('email')} name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby={id('email-error')} />
      <p class="error" id={id('email-error')} role="alert" hidden data-msg={t('error.email')}></p>
    </div>
    <div class="field">
      <label for={id('phone')}>{t('survey.phone')}</label>
      <input id={id('phone')} name="phone" type="tel" autocomplete="tel" required minlength="5" maxlength="40" aria-describedby={id('phone-error')} />
      <p class="error" id={id('phone-error')} role="alert" hidden data-msg={t('survey.error.phone')}></p>
    </div>
    <div class="field check">
      <input id={id('consent')} name="consent" type="checkbox" required aria-describedby={id('consent-error')} />
      <label for={id('consent')}>
        {t('form.consent')}
        <a href={localeUrl(locale, '/privacy')}>{t('footer.privacy')}</a>
      </label>
      <p class="error" id={id('consent-error')} role="alert" hidden data-msg={t('error.consent')}></p>
    </div>
    {
      siteKey && (
        <div class="turnstile">
          <div data-turnstile />
          <p class="error" id={id('turnstile-error')} role="alert" hidden />
        </div>
      )
    }
  </fieldset>

  <!-- Honeypot: извън екрана, извън tab реда; ботовете го попълват. -->
  <div class="hp" aria-hidden="true">
    <label for={id('website')}>{t('form.honeypot')}</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="nav">
    <button class="back" type="button" data-back hidden>{t('survey.back')}</button>
    <button class="btn" type="button" data-next hidden>{t('survey.next')}</button>
    <button class="btn" type="submit" data-submit>{submitText}</button>
  </div>

  <slot name="after">
    <p class="promise">
      {t('form.promise')}
      <a class="mono" href={company.phoneHref}>{company.phone}</a>&nbsp;·
      <a class="mono" href={`mailto:${company.email}`}>{company.email}</a>
    </p>
  </slot>
</form>

{
  siteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=psSurveyTurnstile" async defer />
  )
}

<script>
  // Стъпки, валидация по стъпка, частични известия, изпращане с fetch. Без скрипта формата е
  // една дълга и прави обикновен POST (сървърът пренасочва към /f/sent или /f/not-eligible).
  // Window.turnstile е деклариран в InquiryForm.astro (reset без аргумент); тук се разширява
  // локално с render/reset(id) през cast, за да не се разминават двете декларации.
  type Turnstile = { render: (el: HTMLElement, opts: Record<string, string>) => string; reset: (id?: string) => void };
  declare global {
    interface Window {
      psSurveyTurnstile?: () => void;
    }
  }
  const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;
  type Reply = { ok: boolean; ineligible?: boolean; message?: string; errors?: Record<string, string> };

  for (const form of document.querySelectorAll<HTMLFormElement>('form.survey')) {
    form.dataset.js = '';
    form.noValidate = true;
    const total = Number(form.dataset.total ?? 5);
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]')];
    const progress = form.querySelector<HTMLElement>('[data-progress]');
    const progressText = form.querySelector<HTMLElement>('[data-progress-text]');
    const bars = [...form.querySelectorAll<HTMLElement>('[data-bar]')];
    const status = form.querySelector<HTMLElement>('.form-status');
    const back = form.querySelector<HTMLButtonElement>('[data-back]');
    const next = form.querySelector<HTMLButtonElement>('[data-next]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const ineligible = form.querySelector<HTMLElement>('[data-ineligible]');
    const ts = form.querySelector<HTMLInputElement>('input[name="ts"]');
    const sessionInput = form.querySelector<HTMLInputElement>('input[name="session"]');
    const eventInput = form.querySelector<HTMLInputElement>('input[name="event"]');
    const stepInput = form.querySelector<HTMLInputElement>('input[name="step"]');
    const turnstileEl = form.querySelector<HTMLElement>('[data-turnstile]');
    const submitLabel = submit?.textContent ?? '';
    let turnstileId: string | null = null;
    let cur = 0;

    if (ts) ts.value = String(Date.now());
    // Сесията свързва известията от една анкета; пази се в таба, за да оцелее презареждане.
    const key = `survey:${form.querySelector<HTMLInputElement>('input[name="campaign"]')?.value ?? ''}`;
    let session = '';
    try {
      session = sessionStorage.getItem(key) ?? '';
    } catch {}
    if (!session) {
      session = (crypto.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`).toLowerCase();
      try {
        sessionStorage.setItem(key, session);
      } catch {}
    }
    if (sessionInput) sessionInput.value = session;
    if (progress) progress.hidden = false;
    if (next) next.hidden = false;

    type FormField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const fieldsOf = (i: number): FormField[] =>
      [...steps[i].querySelectorAll('input:not([type="hidden"]), select, textarea')] as FormField[];
    const errorFor = (name: string) => form.querySelector<HTMLElement>(`.error[id$="-${name}-error"]`);

    const clearErrors = (i?: number) => {
      const scope = i === undefined ? form : steps[i];
      for (const el of scope.querySelectorAll<HTMLElement>('[aria-invalid]')) el.removeAttribute('aria-invalid');
      for (const p of scope.querySelectorAll<HTMLElement>('.error')) {
        p.hidden = true;
        p.textContent = '';
      }
      if (status && i === undefined) {
        status.hidden = true;
        status.textContent = '';
      }
    };

    const showError = (name: string, text: string) => {
      const p = errorFor(name);
      if (p) {
        p.textContent = text;
        p.hidden = false;
      }
      for (const input of form.querySelectorAll<HTMLElement>(`[name="${name}"]`)) input.setAttribute('aria-invalid', 'true');
    };

    const renderTurnstile = () => {
      const ts = turnstile();
      if (!turnstileEl || turnstileId !== null || !ts || !form.dataset.sitekey) return;
      turnstileId = ts.render(turnstileEl, { sitekey: form.dataset.sitekey, language: form.dataset.locale ?? 'bg' });
    };
    window.psSurveyTurnstile = () => {
      if (cur === total - 1) renderTurnstile();
    };

    const show = (i: number, focus = true) => {
      cur = i;
      steps.forEach((s, k) => s.toggleAttribute('data-active', k === i));
      bars.forEach((b, k) => b.toggleAttribute('data-done', k <= i));
      if (progressText) progressText.textContent = (form.dataset.stepLabel ?? '').replace('{n}', String(i + 1)).replace('{total}', String(total));
      const last = i === total - 1;
      if (back) back.hidden = i === 0;
      if (next) next.hidden = last || (i === 0 && registeredNo());
      if (submit) submit.hidden = !last;
      if (last) renderTurnstile();
      if (focus) {
        const first = fieldsOf(i)[0];
        const target = (first?.type === 'radio' ? steps[i].querySelector('legend') : first) as HTMLElement | null;
        target?.focus();
      }
      steps[i].scrollIntoView({ block: 'nearest', behavior: 'auto' });
    };

    const registeredNo = () => form.querySelector<HTMLInputElement>('input[name="registered"][value="no"]')?.checked ?? false;

    // Валидация на една стъпка с native constraint API; текстовете са от data-msg (COPY.md).
    const validate = (i: number): boolean => {
      clearErrors(i);
      let firstBad: FormField | null = null;
      const seen = new Set<string>();
      for (const el of fieldsOf(i)) {
        if (seen.has(el.name)) continue;
        seen.add(el.name);
        if (el.checkValidity()) continue;
        showError(el.name, errorFor(el.name)?.dataset.msg ?? el.validationMessage);
        firstBad ??= el;
      }
      firstBad?.focus();
      return firstBad === null;
    };

    // Частично известие (стъпка или спиране) - без да чакаме отговор; keepalive и при затваряне.
    const report = (event: 'step' | 'stop', step: number) => {
      const body = new FormData(form);
      body.set('event', event);
      body.set('step', String(step));
      body.delete('cf-turnstile-response');
      fetch(form.action, { method: 'POST', body, keepalive: true, headers: { accept: 'application/json' } }).catch(() => {});
    };

    // Първи въпрос: „не“ → съобщение, без път напред; „да“ → продължава.
    let stopped = false;
    for (const r of form.querySelectorAll<HTMLInputElement>('input[name="registered"]')) {
      r.addEventListener('change', () => {
        clearErrors(0);
        const no = registeredNo();
        if (ineligible) ineligible.hidden = !no;
        if (next) next.hidden = no;
        if (no && !stopped) {
          stopped = true;
          report('stop', 1);
        }
      });
    }

    // Всяка стъпка се докладва веднъж (при „Назад“ и пак „Напред“ няма второ известие).
    let reported = 0;
    next?.addEventListener('click', () => {
      if (!validate(cur)) return;
      if (cur + 1 > reported) {
        reported = cur + 1;
        report('step', reported);
      }
      show(cur + 1);
    });
    back?.addEventListener('click', () => show(cur - 1));

    const stepOfField = (name: string) => steps.findIndex((s) => s.querySelector(`[name="${name}"]`));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate(cur)) return;
      clearErrors();
      if (submit) {
        submit.disabled = true;
        submit.textContent = form.dataset.sending ?? submitLabel;
      }
      if (eventInput) eventInput.value = 'submit';
      if (stepInput) stepInput.value = String(total);
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const reply = (await res.json()) as Reply;
        if (reply.ok) {
          const done = document.createElement('p');
          done.className = 'form-success';
          done.setAttribute('role', 'status');
          done.tabIndex = -1;
          done.textContent = form.dataset.success ?? '';
          form.replaceChildren(done);
          done.focus();
          return;
        }
        const names = Object.keys(reply.errors ?? {});
        const orphan: string[] = [];
        for (const [name, text] of Object.entries(reply.errors ?? {})) {
          if (errorFor(name)) showError(name, text);
          else orphan.push(text);
        }
        const target = names.map(stepOfField).filter((k) => k >= 0).sort((a, b) => a - b)[0];
        if (target !== undefined) show(target, false);
        const first = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        if (status && (names.length === 0 || orphan.length)) {
          status.textContent = orphan[0] ?? reply.message ?? form.dataset.errorNetwork ?? '';
          status.hidden = false;
        }
        (first ?? status)?.focus?.();
        turnstile()?.reset(turnstileId ?? undefined);
      } catch {
        if (status) {
          status.textContent = form.dataset.errorNetwork ?? '';
          status.hidden = false;
          status.focus();
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });

    show(0, false);
  }
</script>

<style>
  .survey {
    max-width: var(--measure);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  /* С JS се вижда само текущата стъпка; без JS - всички, една под друга. */
  .survey[data-js] fieldset:not([data-active]) {
    display: none;
  }

  .survey:not([data-js]) fieldset + fieldset {
    margin-top: var(--spacing-6);
    padding-top: var(--spacing-6);
    border-top: 1px solid var(--color-line);
  }

  legend {
    padding: 0;
    margin: 0 0 var(--spacing-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
    line-height: 1.25;
    text-wrap: balance;
  }

  legend:focus {
    outline: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Напредък: „Стъпка 2 от 5“ + пет чертички; готовите са в петрол. */
  .progress {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    margin: 0 0 var(--spacing-6);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--spacing-1);
  }

  .bar {
    height: var(--spacing-1);
    background: var(--color-line);
    border-radius: var(--radius-sm);
  }

  .bar[data-done] {
    background: var(--color-primary);
  }

  /* Да / Не: два големи избора един до друг, ≥ 44 px зона за докосване. */
  .choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-3);
  }

  .choice {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-3) var(--spacing-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .choice:hover {
    border-color: var(--color-ink);
  }

  .choice:has(input:checked) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .choice input {
    width: var(--spacing-4);
    height: var(--spacing-4);
    margin: 0;
    accent-color: var(--color-primary);
  }

  .ineligible {
    margin: var(--spacing-4) 0 0;
    padding: var(--spacing-4) var(--spacing-6);
    background: var(--color-accent-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .ineligible a {
    color: var(--color-primary);
    white-space: nowrap;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    margin-bottom: var(--spacing-4);
  }

  label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--spacing-3) var(--spacing-4);
    width: 100%;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-ink);
  }

  [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .check {
    display: grid;
    grid-template-columns: auto 1fr;
