---
// Заместител за изображение, което още не е качено (DESIGN.md §Ревизия, §Изображения).
// „screenshot“: продуктова рамка с адресен ред (mono само за латиница) и wireframe панел —
// странична лента и редове без текст, за да изглежда като софтуер, без измислени данни.
// „photo“: плосък блок в accent-soft с mono „снимка“.
interface Props {
  label: string;
  caption?: string;
  bar?: string;
  variant?: 'screenshot' | 'photo';
  ratio?: string;
  class?: string;
}

const { label, caption, bar, variant = 'screenshot', ratio = '16 / 10', class: cls } = Astro.props;
const name = caption ? `${label}: ${caption}` : label;
const barText = bar ?? caption ?? label;
const barMono = /^[\x00-\x7F]*$/.test(barText);
const rows = [0.9, 0.55, 0.75, 0.4, 0.65];
---

{
  variant === 'screenshot' ? (
    <div class:list={['frame ph-frame', cls]} role="img" aria-label={name}>
      <div class:list={['frame-bar', barMono && 'mono']}>{barText}</div>
      <div class="panel" style={`aspect-ratio: ${ratio}`}>
        <div class="wire" aria-hidden="true">
          <div class="side">
            <span />
            <span />
            <span />
            <span />
          </div>
          <div class="main">
            <div class="topbar" />
            {rows.map((w) => (
              <div class="row" style={`width: ${Math.round(w * 100)}%`} />
            ))}
          </div>
        </div>
        <div class="note">
          <span class="mono">{label}</span>
          {caption && bar && <span class="cap">{caption}</span>}
        </div>
      </div>
    </div>
  ) : (
    <div class:list={['ph', 'ph-photo', cls]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={name}>
      <span class="mono">{label}</span>
      {caption && <span class="cap">{caption}</span>}
    </div>
  )
}

<style>
  .panel {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
    color: var(--color-muted);
  }

  /* Wireframe: 22 % странична лента + редове с различна дължина. */
  .wire {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 22% 1fr;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    background: var(--color-surface);
    border-right: 1px solid var(--color-line);
  }

  .side span {
    display: block;
    height: var(--spacing-2);
    background: var(--color-line);
  }

  .side span:first-child {
    width: 70%;
    background: var(--color-primary-soft);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
  }

  .topbar {
    height: var(--spacing-3);
    width: 40%;
    background: var(--color-line);
    margin-bottom: var(--spacing-2);
  }

  .row {
    height: var(--spacing-2);
    background: var(--color-line);
  }

  .note {
    position: absolute;
    left: var(--spacing-4);
    bottom: var(--spacing-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .ph {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--spacing-1);
    padding: var(--spacing-4);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .ph-photo {
    background: var(--color-accent-soft);
  }

  .cap {
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
