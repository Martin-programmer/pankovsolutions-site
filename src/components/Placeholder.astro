---
// Заместител за изображение, което още не е качено (DESIGN.md §Ревизия, §Изображения).
// „screenshot“: продуктова рамка с mono адресен ред (реалният домейн/системата от `bar`)
// и празен панел с етикет — не гол сив правоъгълник, но и без измислени екрани.
// „photo“: плосък блок в accent-soft с mono „снимка“.
interface Props {
  label: string;
  caption?: string;
  bar?: string;
  variant?: 'screenshot' | 'photo';
  ratio?: string;
  class?: string;
}

const { label, caption, bar, variant = 'screenshot', ratio = '16 / 10', class: cls } = Astro.props;
const name = caption ? `${label}: ${caption}` : label;
const barText = bar ?? caption ?? label;
// Адресният ред е mono само за латиница (домейн/система) — mono-то няма български форми.
const barMono = /^[\x00-\x7F]*$/.test(barText);
---

{
  variant === 'screenshot' ? (
    <div class:list={['frame ph-frame', cls]} role="img" aria-label={name}>
      <div class:list={['frame-bar', barMono && 'mono']}>{barText}</div>
      <div class="panel" style={`aspect-ratio: ${ratio}`}>
        <span class="mono">{label}</span>
        {caption && bar && <span class="cap">{caption}</span>}
      </div>
    </div>
  ) : (
    <div class:list={['ph', 'ph-photo', cls]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={name}>
      <span class="mono">{label}</span>
      {caption && <span class="cap">{caption}</span>}
    </div>
  )
}

<style>
  .panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--spacing-1);
    padding: var(--spacing-4);
    background: var(--color-paper);
    color: var(--color-muted);
  }

  .ph {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--spacing-1);
    padding: var(--spacing-4);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .ph-photo {
    background: var(--color-accent-soft);
  }

  .cap {
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
