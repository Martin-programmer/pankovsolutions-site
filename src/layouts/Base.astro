---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Locale } from '../i18n/utils';
import { ogPages, ogSlugFor } from '../lib/og-pages';

interface Props {
  title: string;
  // Без description, когато в content/ още няма такова — празен meta таг е по-лошо от липсващ.
  description?: string;
  locale?: Locale;
  noindex?: boolean;
  // OG изображение; по подразбиране /og/<път>.png, ако е генерирано, иначе /og/index.png.
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  locale = (Astro.currentLocale as Locale | undefined) ?? 'bg',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const t = useTranslations(locale);

// Canonical + hreflang. bg е без префикс, en под /en/. hreflang към en се слага само когато
// EN версията реално съществува в content/ (иначе линкът би сочил към 404); x-default е bg.
const site = Astro.site?.href ?? 'https://pankovsolutions.com/';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const bgUrl = new URL(bare, site).href;
const enUrl = new URL(bare === '/' ? '/en' : `/en${bare}`, site).href;
const canonical = locale === 'bg' ? bgUrl : enUrl;

const contentKey = bare === '/' ? 'home' : bare.slice(1);
const enIds = new Set(
  [...(await getCollection('pages')), ...(await getCollection('projects'))]
    .filter((e) => e.id.startsWith('en/'))
    .map((e) => e.id.slice(3)),
);
const hasEn = enIds.has(contentKey) || (contentKey === 'projects' && [...enIds].some((id) => id.startsWith('projects/')));

const ogSlugs = new Set((await ogPages()).map((p) => p.slug));
const ogSlug = ogSlugFor(path);
const ogImage = new URL(Astro.props.ogImage ?? `/og/${ogSlugs.has(ogSlug) ? ogSlug : 'index'}.png`, site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="bg" href={bgUrl} />
          {hasEn && <link rel="alternate" hreflang="en" href={enUrl} />}
          <link rel="alternate" hreflang="x-default" href={bgUrl} />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pankov Solutions" />
    <meta property="og:locale" content={locale === 'bg' ? 'bg_BG' : 'en_US'} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Само двата основни: body 400 и display 700. Останалите три тегла се свалят
         при нужда — preload на петте би се борил за честотна лента с LCP. -->
    <link
      rel="preload"
      href="/fonts/SourceSans3-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SourceSerif4-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  /* Скрит, докато не получи фокус от клавиатурата. */
  .skip-link {
    position: absolute;
    z-index: 10;
    left: var(--spacing-4);
    top: calc(-1 * var(--spacing-16));
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .skip-link:focus {
    top: var(--spacing-4);
  }
</style>
