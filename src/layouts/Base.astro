---
import '../styles/fonts.css';
import '../styles/design.css';
import '../styles/site.css';
import '../styles/mobile.css';
import { headerHtml, footerHtml, hasTurnstile } from '../lib/render';
import { pathFor, type Locale } from '../data/pages';

interface Props {
  key: string;
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  // false за 404: няма собствен адрес, затова без canonical/hreflang.
  indexable?: boolean;
  css?: string;
  jsonLd?: unknown;
  ogType?: 'website' | 'article';
  // Само страниците с форма зареждат Turnstile.
  turnstile?: boolean;
}

const { key, locale, title, description, noindex = false, indexable = true, css = '', jsonLd, ogType = 'website', turnstile = false } = Astro.props;
const site = 'https://pankovsolutions.com';
const abs = (p: string) => site + (p === '/' ? '' : p);
const bgUrl = abs(pathFor(key, 'bg'));
const enUrl = abs(pathFor(key, 'en'));
const canonical = locale === 'bg' ? bgUrl : enUrl;
// Страниците с noindex (и 404) нямат собствена OG картинка; ползват тази на началната.
const ogKey = key === 'home' || noindex || !indexable ? 'index' : key;
const ogImage = `${site}/og/${locale === 'en' ? 'en/' : ''}${ogKey}.png`;

// Тракинг (Google Analytics 4, Google Ads, Meta Pixel): ID-тата идват при build от
// Build → Variables. Без нито едно ID банерът за бисквитки не се показва, защото тогава
// сайтът ползва само строго необходими бисквитки.
const env = (name: string) => ((process.env[name] ?? import.meta.env[name] ?? '') as string).trim();
const tracking = { ga4: env('GA4_ID'), ads: env('GOOGLE_ADS_ID'), meta: env('META_PIXEL_ID') };
const umamiUrl = env('UMAMI_URL').replace(/\/+$/, '');
const umamiId = env('UMAMI_WEBSITE_ID');
const skip = locale === 'bg' ? 'Към съдържанието' : 'Skip to content';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      indexable && (
        <>
          <link rel="canonical" href={canonical} />
          {!noindex && (
            <>
              <link rel="alternate" hreflang="bg" href={bgUrl} />
              <link rel="alternate" hreflang="en" href={enUrl} />
              <link rel="alternate" hreflang="x-default" href={bgUrl} />
            </>
          )}
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A2A66" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pankov Solutions" />
    <meta property="og:locale" content={locale === 'bg' ? 'bg_BG' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'bg' ? 'en_US' : 'bg_BG'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/onest-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {css && <style is:inline set:html={css} />}
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <script
      is:inline
      src="/consent.js"
      defer
      data-lang={locale}
      data-policy={pathFor('cookies', locale)}
      data-ga4={tracking.ga4}
      data-ads={tracking.ads}
      data-meta={tracking.meta}></script>
    {umamiUrl && umamiId && <script is:inline defer src={`${umamiUrl}/script.js`} data-website-id={umamiId} />}
    {turnstile && hasTurnstile() && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
  </head>
  <body>
    <div style="min-height: 100vh; background: #F6F8FB; position: relative;">
      <a href="#sadarzhanie" class="ps-skip">{skip}</a>
      <Fragment set:html={headerHtml(key, locale)} />
      <slot />
      <Fragment set:html={footerHtml(locale)} />
    </div>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
