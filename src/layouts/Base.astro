---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: 'bg' | 'en';
  noindex?: boolean;
}

const { title, description, locale = 'bg', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Само двата основни: body 400 и display 700. Останалите три тегла се свалят
         при нужда — preload на петте би се борил за честотна лента с LCP. -->
    <link
      rel="preload"
      href="/fonts/SourceSans3-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SourceSerif4-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  /* Скрит, докато не получи фокус от клавиатурата. */
  .skip-link {
    position: absolute;
    z-index: 10;
    left: var(--spacing-4);
    top: calc(-1 * var(--spacing-16));
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    transition: top 120ms ease-out;
  }

  .skip-link:focus {
    top: var(--spacing-4);
  }
</style>
