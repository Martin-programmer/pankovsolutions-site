# Копирай като .env за локална разработка. Реалните стойности живеят САМО в
# Cloudflare Worker → Settings → Variables and Secrets / Build → Variables (виж CLAUDE.md §Стек).
# .env е в .gitignore и никога не влиза в repo-то.

# Resend — изпращане на имейл от hello@pankovsolutions.com (верифициран домейн).
RESEND_API_KEY=

# Cloudflare Turnstile — server-side siteverify на формата.
TURNSTILE_SECRET=
# Публичен ключ, вгражда се в HTML-а на формата.
TURNSTILE_SITE_KEY=

# Telegram известие при ново запитване.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Umami аналитика (без бисквитки). И двете при build; без тях скриптът не се вгражда.
# UMAMI_URL=https://analytics.pankovsolutions.com  (или https://cloud.umami.is)
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Rate limit: KV namespace-ът INQUIRY_RL е в wrangler.toml (id от Dashboard → KV).
# Локално тестване без ключове: INQUIRY_MOCK=1 в .dev.vars (виж README.md §Форма - настройка).
